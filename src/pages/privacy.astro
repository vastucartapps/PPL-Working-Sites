---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Privacy Policy | EV Charger One";
const pageDescription = "Privacy policy and lead protection terms for EV Charger One residential EV charger installation dispatch services in Central Oregon.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-16 bg-white border-b border-brand-slate-200 grid-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="mono-tag mb-3">// PRIVACY & DATA PROTECTION</span>
      <h1 class="text-3xl sm:text-5xl font-black text-brand-slate-900 tracking-tight mb-4">
        Privacy Policy
      </h1>
      <p class="text-sm sm:text-base text-brand-slate-600 font-medium">
        Last updated: July 30, 2026. EV Charger One is committed to maintaining strict data privacy for all lead submissions and quote inquiries.
      </p>
    </div>
  </section>

  <section class="py-16 bg-brand-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-slate-800 text-sm sm:text-base leading-relaxed">
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-3">1. Information Collection & Usage</h2>
        <p>
          We collect personal information (including name, phone number, vehicle model, city location, and service request details) submitted voluntarily via our quote request forms or phone calls. This data is used strictly to match you with a licensed Oregon electrical contractor (CCB #248910 partner network) to fulfill your Level 2 EV charger estimate.
        </p>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-3">2. Zero Spam Guarantee</h2>
        <p>
          We do not sell, rent, or trade your personal contact details to unverified third-party marketing brokers. Your lead data is transmitted exclusively to authorized electrical contractors assigned to service your Deschutes County location.
        </p>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-3">3. TCPA Phone Communication Consent</h2>
        <p>
          By submitting a form or placing a call to (541) 555-0199, you authorize EV Charger One and its licensed contractor partners to contact you via telephone or SMS text message regarding your electrical installation quote.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
