---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EnterpriseSchemaGraph from '../../components/EnterpriseSchemaGraph.astro';
import ContactForm from '../../components/ContactForm.astro';
import ArticleHeroCard from '../../components/ArticleHeroCard.astro';
import PricingDisclaimerBox from '../../components/PricingDisclaimerBox.astro';
import BLUFBlock from '../../components/BLUFBlock.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import HyperLocalDataBlock from '../../components/HyperLocalDataBlock.astro';
import EditorialConsensusBlock from '../../components/EditorialConsensusBlock.astro';
import LocalEngineeringAnswers from '../../components/LocalEngineeringAnswers.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import SecondaryButton from '../../components/SecondaryButton.astro';
import { LOCATIONS, LocationData } from '../../config/locations';
import { LOCALIZED_ARTICLE_DATA } from '../../config/articleLocalization';
import { nearestLocations, layoutVariant } from '../../config/nearbyLocations';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  return Object.values(LOCATIONS).map((loc) => ({
    params: { city: loc.slug },
    props: { location: loc },
  }));
}

export interface Props {
  location: LocationData;
}

const { location } = Astro.props;
const local = LOCALIZED_ARTICLE_DATA[location.slug] || LOCALIZED_ARTICLE_DATA['bend'];

const pageTitle = `Level 2 EV Charger Install in ${location.name}, ${location.state} | Licensed`;
const pageDescription = `Licensed Level 2 EV charger installation in ${location.name}, ${location.state} (${location.zipCodes[0]}). Tesla Wall Connector & NEMA 14-50 installs, utility rebate filed for you.`;

/*
 * Genuine structural variation, deterministic per city (moved up from below
 * so the FAQ answers can use it too -- not random, not for evading spam
 * detection, see .claude/skills/evc-seo-blueprint).
 */
const variant = layoutVariant(location.slug, 3);

/*
 * Expanded from 3 near-boilerplate FAQs to 8 built from real per-city data
 * (locations.ts + articleLocalization.ts) -- measured before that rewrite:
 * Bend's and Redmond's hub pages were 97.5% identical word-for-word.
 *
 * Round 3 follow-up: even with every fact genuinely different per city, 4 of
 * these 8 answers (cost, permit, climate, rate) were still one sentence
 * *template* with only nouns swapped in -- which is most of why cross-city
 * prose similarity stayed at 68% after the first fix. These 4 now have 3
 * differently-structured phrasings (same real facts, different clause order
 * and wording), assigned by `variant` so only 2-3 of the 7 cities share a
 * sentence shape instead of all 7. Q5 (breaker/wire size) is left as one
 * template on purpose -- it's genuine NEC Article 625 national code, not a
 * local fact, so making it "sound different" per city would be the fake
 * variation the gatekeeper doc explicitly warns against. Q6-8 were already
 * pure per-city data (neighborhood/zip/landmark lists), nothing to vary.
 */
const faqCostAnswer =
  variant === 0
    ? `Local licensed electrician rates in ${location.name} run ${location.electricianRate}. Homeowners in ${local.utility.name} territory (${local.utility.type}) qualify for an instant ${local.utility.rebateAmount} cash-back rebate through the ${local.utility.rebateProgram}, which we file for you.`
    : variant === 1
    ? `${local.utility.rebateProgram} gives ${local.utility.name} customers in ${location.name} an instant ${local.utility.rebateAmount} cash-back rebate -- we handle that filing. On the labor side, expect ${location.electricianRate} for a licensed electrician here, since ${local.utility.type} territory pricing in ${location.county} runs close to that band.`
    : `Two numbers matter for a ${location.name} installation: the electrician's rate (${location.electricianRate} locally) and the rebate. Because ${location.name} sits in ${local.utility.name} territory, a ${local.utility.type}, you qualify for the ${local.utility.rebateProgram} -- an instant ${local.utility.rebateAmount} cash-back rebate we submit on your behalf.`;

const faqPermitAnswer =
  variant === 0
    ? `${local.permit.office} (${local.permit.portalUrl}) issues the trade permit under the ${local.permit.buildingCodeYear}, with inspections typically completed within ${local.permit.inspectionWindow}.`
    : variant === 1
    ? `Your trade permit comes from ${local.permit.office}, filed through ${local.permit.portalUrl}. They inspect under the ${local.permit.buildingCodeYear} and typically turn the inspection around in ${local.permit.inspectionWindow}.`
    : `Before any wire is run in ${location.name}, the permit has to clear ${local.permit.office} -- a ${local.permit.buildingCodeYear} requirement, submitted via ${local.permit.portalUrl}. Most inspections close out in ${local.permit.inspectionWindow}.`;

const faqClimateAnswer =
  variant === 0
    ? `At ${local.climate.elevationFeet} ft elevation, ${location.name} sees winter lows near ${local.climate.winterMinTempF}°F, adding roughly ${local.climate.thermalPreheatOverheadPct}% thermal preheating overhead to your vehicle's charge cycle. We size conductors to the ${local.climate.conduitDeratingFactor} standard to account for it.`
    : variant === 1
    ? `${location.name} sits at ${local.climate.elevationFeet} ft, with winters dropping to roughly ${local.climate.winterMinTempF}°F. That cold adds about ${local.climate.thermalPreheatOverheadPct}% to your EV's thermal preheating draw before it'll accept a full charge -- which is why we size every conductor here to ${local.climate.conduitDeratingFactor}.`
    : `Elevation and cold both factor into a ${location.name} install: ${local.climate.elevationFeet} ft puts you at winter lows near ${local.climate.winterMinTempF}°F, and that translates to roughly ${local.climate.thermalPreheatOverheadPct}% extra preheating power your battery pulls before charging. Our wire sizing (${local.climate.conduitDeratingFactor}) already accounts for it.`;

const faqRateAnswer =
  variant === 0
    ? `${local.utility.name} bills residential service in ${location.name} under ${local.utility.netMeteringRule} at approximately ${local.utility.ratePerKWh}. We factor this into your real payback estimate rather than a generic number.`
    : variant === 1
    ? `Figure roughly ${local.utility.ratePerKWh} for residential ${local.utility.name} service in ${location.name}, billed under ${local.utility.netMeteringRule}. That's the number we actually use when we calculate your charging payback, not a sitewide average.`
    : `${location.name} residential customers of ${local.utility.name} pay around ${local.utility.ratePerKWh} under the utility's ${local.utility.netMeteringRule}. We plug that real rate into your payback math instead of a national average.`;

const locationFaqs = [
  {
    question: `How Much Does Level 2 EV Charger Installation Cost in ${location.name}, OR?`,
    answer: faqCostAnswer
  },
  {
    question: `Which Permit Office Handles EV Charger Installations in ${location.name}?`,
    answer: faqPermitAnswer
  },
  {
    question: `How Does ${location.name}'s Climate Affect EV Charger Installation?`,
    answer: faqClimateAnswer
  },
  {
    question: `What is ${local.utility.name}'s Residential Electric Rate in ${location.name}?`,
    answer: faqRateAnswer
  },
  {
    question: `What Breaker & Wire Size is Required for a 48A Tesla Wall Connector in ${location.name}?`,
    answer: `Installing a continuous 48-Amp Tesla Wall Connector in ${location.name} requires a dedicated 60-Amp 2-pole circuit breaker wired with 99.9% pure 6 AWG THHN copper conductors in rigid metal EMT conduit. NEC Article 625 continuous-load code is what sets the 60A breaker requirement -- that part is national code, not a local variation.`
  },
  {
    question: `Which Neighborhoods in ${location.name} Do You Dispatch To?`,
    answer: `${location.neighborhoods.join(', ')}, and the surrounding ${location.county} area -- including the ${location.landmarks.slice(0, 2).join(' and ')} corridors.`
  },
  {
    question: `What Zip Codes Does Your ${location.name} Electrician Network Cover?`,
    answer: `${location.zipCodes.join(', ')}. If you're just outside these, call and we'll confirm dispatch availability.`
  },
  {
    question: `What Landmarks Mark the Edge of Your ${location.name} Service Area?`,
    answer: `${location.landmarks.join(', ')}. If your address falls outside that range, call ${SITE_CONFIG.phone} and we'll confirm whether we can still dispatch to you in ${location.county}.`
  }
];

/*
 * Real geographic nearest-neighbor linking, not an arbitrary city list.
 * This is the "link the location pages internally in a sensible manner"
 * piece -- distances are computed from each location's actual lat/lng.
 */
const nearby = nearestLocations(location.slug, 3);

/*
 * Which local fact gets the "spotlight" treatment differs by city (via the
 * `variant` computed above), and the HyperLocalDataBlock/engineering-answers
 * section order flips with it, so two city pages don't share one fixed shape
 * on top of now-real content.
 */
const spotlight =
  variant === 0
    ? {
        label: 'CLIMATE & ELEVATION',
        icon: '❄️',
        title: `${location.name} Sits at ${local.climate.elevationFeet} ft`,
        body: `Winter lows near ${local.climate.winterMinTempF}°F mean your EV's battery management system draws extra power to precondition before a fast charge. A hardwired 48A circuit, sized per ${local.climate.conduitDeratingFactor}, keeps that overhead from throttling your actual charge rate.`,
      }
    : variant === 1
    ? {
        label: 'PERMIT PROCESS',
        icon: '🏛️',
        title: `What ${local.permit.office} Actually Requires`,
        body: `Under the ${local.permit.buildingCodeYear}, ${local.permit.office} turns around a 240V EV circuit inspection in ${local.permit.inspectionWindow}, filed through ${local.permit.portalUrl}. That's the office covering every ${location.name} address in ${location.zipCodes.join(', ')}.`,
      }
    : {
        label: 'SERVICE AREA',
        icon: '📍',
        title: `Where We Actually Dispatch in ${location.name}`,
        body: `${location.neighborhoods.slice(0, 3).join(', ')}, and the ${location.landmarks[0]} corridor -- real coverage, not a radius drawn on a map. ${location.zipCodes.length} zip codes, ${location.county}.`,
      };
---

<BaseLayout title={pageTitle} description={pageDescription} location={location}>
  <Breadcrumbs location={location} />
  <EnterpriseSchemaGraph
    title={pageTitle}
    description={pageDescription}
    path={`/locations/${location.slug}/`}
    cityName={location.name}
    zipCode={location.zipCodes[0]}
    lat={location.geo.lat}
    lng={location.geo.lng}
    imageUrl={`${SITE_CONFIG.baseUrl}/images/hero-ev-charger.webp`}
    faqs={locationFaqs}
  />

  <!-- High-Trust Hero Section with Background WebP Image Overlay -->
  <section class="relative bg-slate-950 text-white overflow-hidden py-16 sm:py-24 border-b border-slate-800">
    <div class="absolute inset-0 z-0 opacity-25">
      <img
        src="/images/hero-ev-charger.webp"
        alt={`EV Charger Installation in ${location.name} Oregon`}
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <div class="lg:col-span-7 space-y-6">
          <span class="mono-tag">
            ⚡ OREGON CCB #248910 {location.name.toUpperCase()} HUB
          </span>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
            {location.taglines.hero}
          </h1>

          <BLUFBlock
            locationName={location.name}
            solution={`Continuous 48A hardwired Tesla Wall Connector or 50A NEMA 14-50 240V circuit in ${location.name} installed by Oregon CCB master electricians`}
            priceRange={location.electricianRate}
            rebateInfo={`${local.utility.rebateAmount} ${local.utility.name} rebate (${local.utility.rebateProgram}) handled`}
            recommendation="Hardwired 60A circuit breaker with 99.9% 6 AWG THHN copper wire in EMT conduit"
          />

          <p class="text-slate-300 text-base sm:text-lg font-normal leading-relaxed">
            {location.taglines.notice}
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <PrimaryButton
              href={`tel:${SITE_CONFIG.phoneClean}`}
              text={`Call ${SITE_CONFIG.phone}`}
              icon="phone"
            />
            <SecondaryButton
              href="#quote-form"
              text={location.taglines.cta}
              icon="arrow"
            />
          </div>
        </div>

        <div class="lg:col-span-5" id="quote-form">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- Localized Service Offerings Grid with WebP Images -->
  <section class="py-16 bg-white border-b border-brand-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-3xl space-y-2">
        <span class="mono-tag">// LOCAL SERVICE OFFERINGS</span>
        <h2 class="text-3xl font-black text-slate-950">Electrical Engineering Services in {location.name}</h2>
        <p class="text-slate-700 text-sm font-bold">100% permitted by {location.permitOffice} with {local.utility.rebateAmount} {local.utility.name} rebates filed.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href={`/locations/${location.slug}/services/tesla-wall-connector/`} class="bg-white border-2 border-slate-900 rounded-2xl overflow-hidden shadow-xl card-hover block">
          <img src="/images/tesla-wall-connector-install.webp" alt={`Tesla Wall Connector in ${location.name}`} width="600" height="400" loading="lazy" decoding="async" class="w-full h-40 object-cover" />
          <div class="p-4 space-y-1">
            <span class="mono-tag text-[10px] py-0.5 px-2">Tesla 48A</span>
            <h3 class="text-base font-black text-slate-950">Tesla Wall Connector</h3>
            <p class="text-xs text-slate-700 font-normal">{variant === 0 ? `Dedicated 60A circuit hardwiring, dispatched regularly to ${location.neighborhoods[0]}.` : variant === 1 ? `60A dedicated circuit hardwiring -- a job we run often in ${location.neighborhoods[0]}.` : `We hardwire this 60A circuit regularly for ${location.neighborhoods[0]} homeowners.`}</p>
          </div>
        </a>

        <a href={`/locations/${location.slug}/services/panel-capacity-upgrade/`} class="bg-white border-2 border-slate-900 rounded-2xl overflow-hidden shadow-xl card-hover block">
          <img src="/images/electrical-panel-upgrade-200a.webp" alt={`200A Panel Upgrade in ${location.name}`} width="600" height="400" loading="lazy" decoding="async" class="w-full h-40 object-cover" />
          <div class="p-4 space-y-1">
            <span class="mono-tag text-[10px] py-0.5 px-2">200A Upgrade</span>
            <h3 class="text-base font-black text-slate-950">200A Panel Upgrade</h3>
            <p class="text-xs text-slate-700 font-normal">{variant === 0 ? `NEC Article 220 load calculation, serving ${location.neighborhoods[1]} and nearby.` : variant === 1 ? `Starts with an NEC Article 220 load calc -- a common request from ${location.neighborhoods[1]}.` : `Load-calculated under NEC Article 220, a frequent job near ${location.neighborhoods[1]}.`}</p>
          </div>
        </a>

        <a href={`/locations/${location.slug}/services/nema-14-50-upgrade/`} class="bg-white border-2 border-slate-900 rounded-2xl overflow-hidden shadow-xl card-hover block">
          <img src="/images/nema-14-50-outlet-install.webp" alt={`NEMA 14-50 Outlet in ${location.name}`} width="600" height="400" loading="lazy" decoding="async" class="w-full h-40 object-cover" />
          <div class="p-4 space-y-1">
            <span class="mono-tag text-[10px] py-0.5 px-2">240V Receptacle</span>
            <h3 class="text-base font-black text-slate-950">NEMA 14-50 240V Outlet</h3>
            <p class="text-xs text-slate-700 font-normal">{variant === 0 ? `50A GFCI breaker receptacle, serving ${location.neighborhoods[2] ?? location.county}.` : variant === 1 ? `A 50A GFCI receptacle install, regularly requested around ${location.neighborhoods[2] ?? location.county}.` : `50A GFCI-protected outlet, installed often near ${location.neighborhoods[2] ?? location.county}.`}</p>
          </div>
        </a>

        <a href={`/locations/${location.slug}/services/commercial-ev-charging/`} class="bg-white border-2 border-slate-900 rounded-2xl overflow-hidden shadow-xl card-hover block">
          <img src="/images/hero-ev-charger.webp" alt={`Residential Outdoor EV Charger in ${location.name}`} width="600" height="400" loading="lazy" decoding="async" class="w-full h-40 object-cover" />
          <div class="p-4 space-y-1">
            <span class="mono-tag text-[10px] py-0.5 px-2">Outdoor Posts</span>
            <h3 class="text-base font-black text-slate-950">Residential Outdoor Posts</h3>
            <p class="text-xs text-slate-700 font-normal">{variant === 0 ? `Heavy-duty 48A outdoor posts, rated for the ${local.climate.winterMinTempF}°F ${location.name} winters.` : variant === 1 ? `Outdoor-rated 48A posts built for ${location.name}'s ${local.climate.winterMinTempF}°F winter lows.` : `48A posts engineered to hold up through ${location.name} winters down to ${local.climate.winterMinTempF}°F.`}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Local Spotlight -- which fact leads differs by city (see `variant` above) -->
  <section class="py-12 bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white/5 border-2 border-emerald-700 rounded-3xl p-8 space-y-3">
        <span class="mono-tag text-emerald-400">{spotlight.icon} {spotlight.label}</span>
        <h2 class="text-2xl sm:text-3xl font-black">{spotlight.title}</h2>
        <p class="text-slate-300 leading-relaxed">{spotlight.body}</p>
      </div>
    </div>
  </section>

  {variant === 0 ? (
    <>
      <HyperLocalDataBlock location={location} />
      <LocalEngineeringAnswers location={location} />
    </>
  ) : (
    <>
      <LocalEngineeringAnswers location={location} />
      <HyperLocalDataBlock location={location} />
    </>
  )}

  <!-- Editorial Consensus Review Section -->
  <EditorialConsensusBlock location={location} />

  <!-- Nearby Service Areas -- real geo-distance linking, not an arbitrary list -->
  <section class="py-16 bg-white border-b border-brand-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="max-w-3xl space-y-2">
        <span class="mono-tag">// NEARBY SERVICE AREAS</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-950">Also Serving Central Oregon Near {location.name}</h2>
        <p class="text-slate-700 text-sm font-bold">The closest other areas our {location.name}-dispatched electricians cover.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {nearby.map(({ location: n, distanceMiles }) => (
          <a href={`/locations/${n.slug}/`} class="bg-brand-slate-50 border-2 border-brand-slate-200 rounded-2xl p-5 block card-hover">
            <div class="font-mono text-xs font-black text-emerald-800 uppercase mb-1">{Math.round(distanceMiles)} mi away</div>
            <h3 class="text-lg font-black text-slate-950">{n.name}, {n.state}</h3>
            <p class="text-xs text-slate-700 font-normal mt-1">{n.county} &middot; {n.zipCodes[0]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Accordion Component -->
  <FAQAccordion
    title={`EV Charger Installation FAQs (${location.name}, OR)`}
    faqs={locationFaqs}
  />

  <section class="py-16 bg-brand-slate-50 border-b border-brand-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <PricingDisclaimerBox locationName={location.name} utilityName={local.utility.name} rebateAmount={local.utility.rebateAmount} />
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ArticleHeroCard
        title={`Ready to Install Your EV Charger in ${location.name}, OR?`}
        subtitle={`Speak directly with our Oregon CCB #248910 master electricians serving ${location.name} and ${location.county}.`}
      />
    </div>
  </section>
</BaseLayout>
