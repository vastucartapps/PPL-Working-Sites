---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import PricingDisclaimerBox from '../../../components/PricingDisclaimerBox.astro';
import { LOCATIONS, LocationData } from '../../../config/locations';

export function getStaticPaths() {
  return Object.values(LOCATIONS).map((loc) => ({
    params: { city: loc.slug },
    props: { location: loc }
  }));
}

export interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<BaseLayout
  title={`Contact ${location.name} EV Charger Electricians | Oregon CCB #248910`}
  description={`Schedule continuous 48A Level 2 EV charger installation in ${location.name}, ${location.state}. Call ${location.phone} for ${location.rebateAmount} ${location.utilityName} rebate filing & trade permits.`}
  location={location}
>
  <section class="py-16 bg-white border-b border-brand-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="mono-tag mb-4">// FAST DISPATCH: {location.name.toUpperCase()}, {location.state}</span>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-950 tracking-tight leading-tight">
          Request Free EV Charger Estimate in <span class="text-emerald-800">{location.name}, {location.state}</span>
        </h1>
        <p class="text-lg text-slate-950 font-bold mt-4 leading-relaxed">
          Connect directly with licensed Oregon CCB #248910 master electricians serving {location.name} and {location.county}. Free 24-hour estimate & instant {location.utilityName} cash-back rebate processing.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7 space-y-8">
          
          <div class="bg-slate-950 text-white border-2 border-emerald-500 rounded-3xl p-8 shadow-xl space-y-6">
            <h2 class="text-2xl font-black text-white">
              📞 Direct {location.name} Electrician Hotline
            </h2>
            <div class="flex items-center gap-4">
              <a href={`tel:${location.phoneClean}`} style="background-color: #047857; color: #ffffff;" class="btn-primary px-8 py-4 text-base font-black shadow-lg inline-flex items-center gap-3">
                <svg class="w-5 h-5 fill-current text-emerald-300" viewBox="0 0 24 24">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
                <span style="color: #ffffff;" class="font-black">{location.phone}</span>
              </a>
            </div>
            <p class="text-xs text-emerald-300 font-mono font-bold">
              Dispatch Hours: 7:00 AM – 8:00 PM PST (Monday – Saturday)
            </p>
          </div>

          <div class="bg-white border-2 border-brand-slate-200 rounded-3xl p-8 shadow-md space-y-4">
            <h3 class="text-xl font-black text-slate-950">
              {location.name} Trade Permit & Utility Coordination
            </h3>
            <ul class="space-y-3 font-mono text-xs font-black text-slate-950">
              <li class="flex items-center gap-2">
                <span class="text-emerald-700">✓</span> Permit Office: {location.permitOffice}
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-700">✓</span> Utility Provider: {location.utilityName} ({location.rebateAmount} Cash-Back Filing)
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-700">✓</span> Electrician Labor Rate: {location.electricianRate}
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-700">✓</span> Service Zip Codes: {location.zipCodes.join(', ')}
              </li>
            </ul>
          </div>

          <PricingDisclaimerBox />
        </div>

        <div class="lg:col-span-5">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
