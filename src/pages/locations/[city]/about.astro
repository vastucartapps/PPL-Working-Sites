---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import PricingDisclaimerBox from '../../../components/PricingDisclaimerBox.astro';
import HyperLocalDataBlock from '../../../components/HyperLocalDataBlock.astro';
import EditorialConsensusBlock from '../../../components/EditorialConsensusBlock.astro';
import { LOCATIONS, LocationData } from '../../../config/locations';

export function getStaticPaths() {
  return Object.values(LOCATIONS).map((loc) => ({
    params: { city: loc.slug },
    props: { location: loc }
  }));
}

export interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<BaseLayout
  title={`About Network - Master Electricians in ${location.name}, ${location.state} | EV Charger One`}
  description={`Learn about our network of licensed Oregon CCB #248910 master electricians serving ${location.name}, ${location.state} across ${location.landmarks.join(', ')}.`}
  location={location}
>
  <section class="py-16 bg-white border-b border-brand-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="mono-tag mb-4">// OREGON CCB #248910 {location.name.toUpperCase()} HUB</span>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-950 tracking-tight leading-tight">
          About Our Master Electrician Network in <span class="text-emerald-800">{location.name}, {location.state}</span>
        </h1>
        <p class="text-lg text-slate-950 font-bold mt-4 leading-relaxed">
          We are a dedicated network of Oregon CCB-licensed master electricians providing guaranteed Level 2 EV charging station installations across {location.name}, {location.county}, and surrounding Central Oregon communities.
        </p>
      </div>
    </div>
  </section>

  <!-- Phase 4 Module A: Hyper-Local Data Injection Block -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <HyperLocalDataBlock location={location} />
  </div>

  <!-- Phase 4 Module B: Editorial Review Consensus Block -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <EditorialConsensusBlock location={location} />
  </div>

  <section class="py-16 bg-brand-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7 space-y-8">
          <div class="bg-white border-2 border-brand-slate-200 rounded-3xl p-8 shadow-md">
            <h2 class="text-2xl font-black text-slate-950 mb-4">
              Local Service Excellence in {location.name}
            </h2>
            <p class="text-slate-950 font-bold leading-relaxed mb-4">
              Installing continuous 48-Amp Level 2 EV chargers in {location.name} requires exact knowledge of local trade codes and sub-zero weather considerations. From sub-zero insulated conduit runs to guaranteed {location.utilityName} cash-back rebate filings, our certified technicians ensure 100% permit compliance.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-brand-slate-100 font-mono text-xs font-black text-slate-950">
              <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-4">
                <span class="text-emerald-950 font-black block text-sm">📍 PERMIT JURISDICTION</span>
                <span class="text-slate-900 font-bold mt-1 block">{location.permitOffice}</span>
              </div>
              <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-4">
                <span class="text-emerald-950 font-black block text-sm">💰 UTILITY REBATE</span>
                <span class="text-slate-900 font-bold mt-1 block">{location.rebateAmount} Direct Filing via {location.utilityName}</span>
              </div>
            </div>
          </div>

          <div class="bg-white border-2 border-brand-slate-200 rounded-3xl p-8 shadow-md">
            <h3 class="text-xl font-black text-slate-950 mb-4">
              {location.name} Neighborhood Coverage & Zip Codes
            </h3>
            <p class="text-slate-950 font-bold mb-4">
              Our licensed field technicians deploy daily across all {location.name} neighborhoods:
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {location.neighborhoods.map((n) => (
                <span class="bg-slate-950 text-white font-mono text-xs font-black px-3.5 py-1.5 rounded-lg">
                  ✓ {n}
                </span>
              ))}
            </div>
            <div class="font-mono text-xs text-slate-900 font-black">
              Verified Zip Codes: {location.zipCodes.join(', ')}
            </div>
          </div>

          <PricingDisclaimerBox />
        </div>

        <div class="lg:col-span-5">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
