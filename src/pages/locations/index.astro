---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Oregon EV Charger Service Areas & City Directory | EV Charger One";
const pageDescription = "Licensed Level 2 EV charger installation across Bend, Redmond, Sisters, Sunriver, La Pine, and Prineville. Deschutes & Crook County trade permits and $500 Pacific Power rebates.";

const locations = [
  {
    city: "Bend, OR",
    url: "/locations/bend",
    county: "Deschutes County",
    zip: "97701",
    landmarks: "Pilot Butte, Old Mill District, Cascade Lakes, Downtown Bend.",
    badge: "DESCHUTES COUNTY"
  },
  {
    city: "Redmond, OR",
    url: "/locations/redmond",
    county: "Deschutes County",
    zip: "97756",
    landmarks: "Smith Rock State Park, Roberts Field Airport, Dry Canyon Trail.",
    badge: "DESCHUTES COUNTY"
  },
  {
    city: "Sisters, OR",
    url: "/locations/sisters",
    county: "Deschutes County",
    zip: "97759",
    landmarks: "Three Sisters Mountains, Black Butte Ranch, Hood Avenue.",
    badge: "DESCHUTES COUNTY"
  },
  {
    city: "Sunriver, OR",
    url: "/locations/sunriver",
    county: "Deschutes County",
    zip: "97707",
    landmarks: "Sunriver Resort, Benham Falls, Deschutes River.",
    badge: "DESCHUTES COUNTY"
  },
  {
    city: "La Pine, OR",
    url: "/locations/la-pine",
    county: "Deschutes County",
    zip: "97739",
    landmarks: "Newberry National Volcanic Monument, Paulina Lake.",
    badge: "DESCHUTES COUNTY"
  },
  {
    city: "Prineville, OR",
    url: "/locations/prineville",
    county: "Crook County",
    zip: "97754",
    landmarks: "Ochoco Reservoir, Bowman Dam, Crook County Courthouse.",
    badge: "CROOK COUNTY"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-16 bg-white border-b border-brand-slate-200 grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="mono-tag mb-3">// CENTRAL OREGON SERVICE LOCATIONS</span>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-950 tracking-tight">
          EV Charger Installation Locations
        </h1>
        <p class="text-base text-slate-800 font-semibold mt-3">
          Network of independent licensed Oregon electrical contractors (Oregon CCB #248910 partner network) providing Level 2 Tesla Wall Connector & 240V NEMA 14-50 outlet installations across Deschutes and Crook Counties.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-brand-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {locations.map(loc => (
          <a
            href={loc.url}
            class="group bg-white border-2 border-brand-slate-200 hover:border-emerald-500 rounded-3xl p-8 flex flex-col justify-between shadow-sm hover:shadow-xl transition-all"
          >
            <div>
              <div class="font-mono text-[11px] font-black uppercase text-emerald-800 bg-emerald-50 border border-emerald-300 px-3 py-1 rounded-md inline-block mb-4">
                // {loc.badge}
              </div>
              <h2 class="text-2xl font-black text-slate-950 group-hover:text-emerald-700 transition-colors mb-2">
                {loc.city}
              </h2>
              <div class="font-mono text-xs text-slate-700 font-bold mb-4">
                Zip Code: {loc.zip}
              </div>
              <p class="text-xs text-slate-700 font-semibold leading-relaxed mb-6">
                Local landmarks: {loc.landmarks}
              </p>
            </div>

            <!-- High-Converting Service Booking Wording (Fixes Screenshot 2!) -->
            <div class="font-mono text-xs font-black text-emerald-800 group-hover:text-emerald-700 flex items-center gap-2 pt-4 border-t border-brand-slate-200 group-hover:underline">
              <span>BOOK {loc.city.split(',')[0].toUpperCase()} EV INSTALLATION →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
