---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnterpriseSchemaGraph from '../../components/EnterpriseSchemaGraph.astro';
import ContactForm from '../../components/ContactForm.astro';
import ArticleHeroCard from '../../components/ArticleHeroCard.astro';
import PricingDisclaimerBox from '../../components/PricingDisclaimerBox.astro';
import BLUFBlock from '../../components/BLUFBlock.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import SecondaryButton from '../../components/SecondaryButton.astro';
import { SITE_CONFIG } from '../../config/site';

const pageTitle = `Commercial EV Charger Installation Bend, OR | ${SITE_CONFIG.brandName}`;
const pageDescription = "Commercial Level 2 & DC fast charger installation in Bend, OR. Multi-family apartments, retail hubs, fleet charging, and Pacific Power commercial incentives.";

const commercialFaqs = [
  {
    question: "What Utility Incentives Exist for Commercial EV Chargers in Bend, OR?",
    answer: "Pacific Power offers up to $1,000 to $4,000 per port for commercial Level 2 EV charging stations installed at multi-family housing, workplaces, and public commercial sites in Oregon. We submit commercial incentive paperwork directly on your behalf."
  },
  {
    question: "What Electrical Service Capacity is Needed for Commercial Fleet Charging?",
    answer: "Commercial EV charging hubs typically require 208V/240V 3-phase electrical service panels with 400A to 800A capacity depending on port count. We conduct full NEC Article 220 commercial load calculations."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <EnterpriseSchemaGraph
    title={pageTitle}
    description={pageDescription}
    path="/services/commercial-ev-charging"
    pageType="service"
    faqs={commercialFaqs}
  />

  <Breadcrumbs pathName="Commercial EV Charging" />

  <section class="py-16 sm:py-20 bg-white border-b border-brand-slate-200 grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="mono-tag">COMMERCIAL & MULTI-FAMILY HUB</span>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-tight">
            Commercial Level 2 EV Charger Installation in <span class="text-emerald-700">Bend, OR</span>
          </h1>

          <!-- BLUF Block -->
          <BLUFBlock
            locationName="Bend, OR Commercial"
            solution="Multi-port Level 2 charging stations with load-sharing, RFID access control, and commercial 3-phase service integration"
            priceRange="$1,500 – $4,500 per port net cost"
            rebateInfo="Pacific Power commercial rebates up to $4,000/port handled directly"
            recommendation="Hardwired 3-phase 208V/240V commercial electrical infrastructure with City of Bend building inspection sign-off"
          />

          <p class="text-sm sm:text-base text-slate-800 leading-relaxed font-semibold">
            Looking to install commercial EV charging stations at your Bend business, multi-family apartment property, or commercial fleet facility? We engineer turnkey 3-phase electrical infrastructure.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <PrimaryButton
              href={`tel:${SITE_CONFIG.phoneClean}`}
              text={`CALL: ${SITE_CONFIG.phone}`}
              icon="phone"
            />
            <SecondaryButton
              href="#quote-form"
              text="Request Commercial Quote"
            />
          </div>
        </div>

        <div class="lg:col-span-5" id="quote-form">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ Accordion Component -->
  <FAQAccordion
    title="Commercial EV Infrastructure FAQs"
    faqs={commercialFaqs}
  />

  <section class="py-16 bg-brand-slate-50 border-b border-brand-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <PricingDisclaimerBox />
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ArticleHeroCard
        title="Deploy Commercial EV Charging at Your Property"
        subtitle="Speak directly with our Oregon CCB master electricians specializing in commercial fleet and multi-family infrastructure."
      />
    </div>
  </section>
</BaseLayout>
