---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnterpriseSchemaGraph from '../../components/EnterpriseSchemaGraph.astro';
import ContactForm from '../../components/ContactForm.astro';
import ArticleHeroCard from '../../components/ArticleHeroCard.astro';
import PricingDisclaimerBox from '../../components/PricingDisclaimerBox.astro';
import BLUFBlock from '../../components/BLUFBlock.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import SecondaryButton from '../../components/SecondaryButton.astro';
import { SITE_CONFIG } from '../../config/site';

const pageTitle = `Residential Outdoor EV Charger Installation Bend, OR | ${SITE_CONFIG.brandName}`;
const pageDescription = "Residential Level 2 outdoor EV charger installation in Bend, OR. Weatherproof NEMA 4X posts, detached home garage wiring, and Pacific Power residential rebates.";

const commercialFaqs = [
  {
    question: "What Utility Incentives Exist for Outdoor Home EV Chargers in Bend, OR?",
    answer: "Pacific Power offers up to utility rebate per port for residential Level 2 EV charging stations installed at single-family homes in Oregon. We submit residential incentive paperwork directly on your behalf."
  },
  {
    question: "What Electrical Service Capacity is Needed for Outdoor Garage EV Chargers?",
    answer: "Residential outdoor Level 2 EV charging posts require a dedicated 240V 60-Amp circuit breaker with 6 AWG copper conductors. We conduct full NEC Article 220 load calculations for your home."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <EnterpriseSchemaGraph
    title={pageTitle}
    description={pageDescription}
    path="/services/commercial-ev-charging"
    pageType="service"
    faqs={commercialFaqs}
  />

  <Breadcrumbs pathName="Commercial EV Charging" />

  <section class="py-16 sm:py-20 bg-white border-b border-brand-slate-200 grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="mono-tag">RESIDENTIAL OUTSIDE GARAGE POST</span>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-tight">
            Residential Outdoor EV Charger Installation in <span class="text-emerald-700">Bend, OR</span>
          </h1>

          <!-- BLUF Block -->
          <BLUFBlock
            locationName="Bend, OR Residential"
            solution="Weatherproof Level 2 outdoor charging posts with dedicated 60A circuit and 6 AWG copper conductor wiring"
            priceRange="standard installation costs net cost"
            rebateInfo="Pacific Power utility rebate handled directly"
            recommendation="Hardwired weatherproof 240V NEMA 4X outdoor electrical infrastructure with City of Bend building inspection sign-off"
          />

          <p class="text-sm sm:text-base text-slate-800 leading-relaxed font-semibold">
            Looking to install an outdoor Level 2 EV charging post at your Bend home, detached garage, or outdoor parking pad? We engineer turnkey residential electrical infrastructure.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <PrimaryButton
              href={`tel:${SITE_CONFIG.phoneClean}`}
              text={`CALL: ${SITE_CONFIG.phone}`}
              icon="phone"
            />
            <SecondaryButton
              href="#quote-form"
              text="Request Installation Quote"
            />
          </div>
        </div>

        <div class="lg:col-span-5" id="quote-form">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ Accordion Component -->
  <FAQAccordion
    title="Commercial EV Infrastructure FAQs"
    faqs={commercialFaqs}
  />

  <section class="py-16 bg-brand-slate-50 border-b border-brand-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <PricingDisclaimerBox />
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ArticleHeroCard
        title="Deploy Commercial EV Charging at Your Property"
        subtitle="Speak directly with our Oregon CCB master electricians specializing in commercial fleet and multi-family infrastructure."
      />
    </div>
  </section>
</BaseLayout>
