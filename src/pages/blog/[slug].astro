---
import ArticleTemplate from '../../components/ArticleTemplate.astro';
import { getTopicData, TOPIC_ARTICLES_DATA } from '../../config/articleTopics';

export function getStaticPaths() {
  const allSlugs = Object.keys(TOPIC_ARTICLES_DATA);
  return allSlugs.map((slug) => ({
    params: { slug },
    props: { slug }
  }));
}

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const topic = getTopicData(slug);
const defaultImages = [
  { src: topic.featuredImageSrc || '/images/blog/hero-60a-breaker-wiring-bend.webp', alt: topic.title, caption: topic.title },
  { src: topic.sectionalImageSrc || '/images/blog/6-awg-thhn-copper-conduit.webp', alt: topic.title, caption: 'Technical Wiring & Conduit Illustration' }
];
---

<ArticleTemplate
  title={topic.title}
  category={topic.category}
  readTime={topic.readTime}
  canonicalPath={`/blog/${slug}`}
  bluf={topic.bluf}
  specs={topic.specs}
  sections={topic.sections}
  images={(topic as any).images || defaultImages}
  faqs={topic.faqs}
  internalLinks={topic.internalLinks}
  cityName="Bend & Central Oregon"
  state="OR"
/>
