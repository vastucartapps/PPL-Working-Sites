---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnterpriseSchemaGraph from '../../components/EnterpriseSchemaGraph.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleHeroCard from '../../components/ArticleHeroCard.astro';
import { BLOG_SLUGS } from '../[slug].astro';
import { getTopicData } from '../../config/articleTopics';
import { SITE_CONFIG } from '../../config/site';

const articles = BLOG_SLUGS.map((slug) => {
  const topic = getTopicData(slug);
  return {
    slug,
    title: topic.title,
    category: topic.category,
    readTime: topic.readTime,
    excerpt: topic.sections[0]?.content.slice(0, 140) + '...',
    imageSrc: topic.featuredImageSrc
  };
});

const pageTitle = `EV Charging Engineering Articles & Guides | ${SITE_CONFIG.brandName}`;
const pageDescription = `Browse technical Level 2 EV charger installation guides, NEC load calculation tutorials, and Pacific Power rebate step-by-step instructions for Central Oregon.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <EnterpriseSchemaGraph
    title={pageTitle}
    description={pageDescription}
    path="/blog"
  />

  <Breadcrumbs pathName="Engineering Guides & Articles" />

  <section class="py-16 bg-white grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="mono-tag">
          ⚡ CENTRAL OREGON HARDWARE LIBRARY
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight leading-tight">
          EV Charger Technical Engineering Guides
        </h1>
        <p class="text-slate-700 text-base sm:text-lg font-normal leading-relaxed">
          Comprehensive, electrician-verified guides on 48A hardwiring, NEC Article 625 load calculations, wire ampacity derating, and Pacific Power $500 cash-back rebates.
        </p>
      </div>

      <!-- Article Card Grid displaying Distinct Featured WebP Images -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((article) => (
          <article class="bg-white border-2 border-slate-900 rounded-3xl overflow-hidden shadow-xl card-hover flex flex-col justify-between">
            <div class="space-y-4">
              <!-- Featured WebP Image Card Header -->
              <div class="relative h-48 overflow-hidden bg-slate-950">
                <img
                  src={article.imageSrc}
                  alt={`${article.title} Featured Image`}
                  width="800"
                  height="450"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
                <div class="absolute top-3 left-3">
                  <span class="mono-tag text-[10px] py-1 px-2.5">{article.category}</span>
                </div>
                <div class="absolute bottom-3 right-3 bg-slate-950/80 backdrop-blur text-white font-mono text-[10px] font-bold py-1 px-2.5 rounded-md border border-slate-700">
                  ⚡ {article.readTime}
                </div>
              </div>

              <!-- Card Content -->
              <div class="p-6 space-y-3">
                <h2 class="text-xl font-black text-slate-950 tracking-tight leading-snug hover:text-emerald-700">
                  <a href={`/${article.slug}`}>{article.title}</a>
                </h2>
                <p class="text-slate-700 font-normal text-xs sm:text-sm leading-relaxed line-clamp-3">
                  {article.excerpt}
                </p>
              </div>
            </div>

            <!-- Read Button Footer -->
            <div class="p-6 pt-0">
              <a
                href={`/${article.slug}`}
                class="btn-secondary w-full text-center text-xs py-3 rounded-xl flex items-center justify-center gap-2"
              >
                <span>Read Technical Guide</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <section class="py-20 bg-brand-slate-50 grid-bg border-t border-brand-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ArticleHeroCard
        title="Need Custom Electrical Load Calculation Advice?"
        subtitle="Speak directly with Oregon CCB licensed master electricians serving Bend, Redmond, and Sisters."
      />
    </div>
  </section>
</BaseLayout>
