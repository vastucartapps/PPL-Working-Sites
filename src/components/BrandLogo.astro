---
export interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<div class="flex items-center gap-3 group">
  <!-- Custom Vector Emblem Logo -->
  <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white font-black text-xl shadow-md shadow-emerald-600/20 group-hover:scale-105 transition-transform">
    <svg class="w-6 h-6 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M13 2L3 14h7v8l10-12h-7z"/>
    </svg>
  </div>
  <div>
    <span class={`text-lg font-black tracking-tight block leading-tight ${light ? 'text-white' : 'text-slate-950'}`}>
      EV Charger One
    </span>
    <span class={`font-mono text-[10px] uppercase tracking-widest font-black block ${light ? 'text-emerald-400' : 'text-emerald-800'}`}>
      Certified Electrical Network
    </span>
  </div>
</div>
