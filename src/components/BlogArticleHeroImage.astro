---
export interface Props {
  title: string;
  category: string;
  readTime?: string;
  badgeText?: string;
}

const {
  title,
  category,
  readTime = "12 min read",
  badgeText = "NEC 2023 CODE STANDARD"
} = Astro.props;
---

<div class="relative w-full h-64 sm:h-80 bg-slate-950 rounded-3xl overflow-hidden shadow-2xl border-2 border-slate-800 flex flex-col justify-between p-6 sm:p-10 my-8">
  <!-- Dynamic Grid Pattern Background -->
  <div class="absolute inset-0 opacity-15 grid-bg pointer-events-none"></div>

  <!-- Ambient Light Effect -->
  <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header Badges -->
  <div class="relative z-10 flex items-center justify-between font-mono text-xs font-bold uppercase tracking-wider">
    <span class="text-emerald-400 bg-emerald-950 border border-emerald-500/50 px-3 py-1.5 rounded-lg shadow-sm">
      ⚡ {category}
    </span>
    <span class="text-slate-300 bg-slate-800/90 border border-slate-700 px-3 py-1 rounded-lg">
      {badgeText} • {readTime}
    </span>
  </div>

  <!-- Title & Branding -->
  <div class="relative z-10 my-auto space-y-3">
    <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
      {title}
    </h1>
    <div class="font-mono text-xs text-emerald-400 font-bold flex items-center gap-2">
      <span>EV CHARGER ONE EDITORIAL DESK</span>
      <span>•</span>
      <span>OREGON CCB #248910 PARTNER NETWORK</span>
    </div>
  </div>

  <!-- Bottom Accent Gradient Line -->
  <div class="relative z-10 w-full h-1.5 bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-500 rounded-full"></div>
</div>
