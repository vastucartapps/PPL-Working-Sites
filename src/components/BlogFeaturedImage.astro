---
export interface Props {
  title: string;
  category: string;
  badgeText?: string;
}

const { title, category, badgeText = "NEC 2023 COMPLIANT" } = Astro.props;
---

<div class="relative w-full h-48 sm:h-56 bg-brand-slate-900 rounded-2xl overflow-hidden shadow-lg border border-brand-slate-800 flex flex-col justify-between p-6 group">
  <!-- Glowing Background Accent -->
  <div class="absolute -top-16 -right-16 w-48 h-48 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-emerald-500/20 transition-all"></div>

  <!-- Top Badges -->
  <div class="relative z-10 flex items-center justify-between font-mono text-[10px] font-bold uppercase tracking-wider">
    <span class="text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2.5 py-1 rounded">
      {category}
    </span>
    <span class="text-brand-slate-400 bg-brand-slate-800/80 px-2 py-0.5 rounded">
      {badgeText}
    </span>
  </div>

  <!-- Center Vector Graphic Graphic Icon -->
  <div class="relative z-10 my-auto flex items-center gap-3">
    <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-bold text-xl shrink-0">
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
        <path d="M13 2L3 14h7v8l10-12h-7z"/>
      </svg>
    </div>
    <div>
      <div class="text-white font-bold text-sm sm:text-base line-clamp-2 leading-snug">
        {title}
      </div>
      <div class="font-mono text-[11px] text-emerald-400 mt-0.5">
        EV CHARGER ONE EDITORIAL • OREGON CCB #248910
      </div>
    </div>
  </div>

  <!-- Bottom Accent Bar -->
  <div class="relative z-10 w-full h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-500 rounded-full mt-2"></div>
</div>
