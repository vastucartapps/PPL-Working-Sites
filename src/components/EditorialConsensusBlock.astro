---
import { LocationData } from '../config/locations';
import { layoutVariant } from '../config/nearbyLocations';

export interface Props {
  location: LocationData;
}

const { location } = Astro.props;
const variant = layoutVariant(location.slug, 3);
const lastLandmark = location.landmarks[location.landmarks.length - 1];
const trustParagraph =
  variant === 0
    ? `Our Oregon CCB #248910 licensed partner network files every ${location.name} trade permit with ${location.permitOffice} and every ${location.utilityName} rebate paperwork directly -- fixed-price installation, no surprise costs, dispatched across ${location.county} from ${location.landmarks[0]} to ${lastLandmark}.`
    : variant === 1
    ? `Every ${location.name} job runs through our Oregon CCB #248910 licensed partner network: fixed-price installation, zero surprise costs, with ${location.permitOffice} trade permits and ${location.utilityName} rebate paperwork both filed directly by us. Our dispatch range covers all of ${location.county}, ${location.landmarks[0]} to ${lastLandmark}.`
    : `Licensing and paperwork are handled before you ever see a bill: Oregon CCB #248910, a ${location.permitOffice} trade permit, and the ${location.utilityName} rebate filing are all done by our partner network at a fixed price. We dispatch anywhere in ${location.county} -- ${location.landmarks[0]} through ${lastLandmark}.`;
---

<!-- Trust block: real, verifiable operational facts only -- no review/rating claims until real reviews exist -->
<section class="my-12 bg-emerald-950 text-white border-2 border-emerald-500 rounded-3xl p-8 shadow-2xl space-y-6">
  <div>
    <span class="mono-tag bg-emerald-900/90 text-emerald-400 border border-emerald-500/50 mb-2 inline-block">
      ⚡ WHY HOMEOWNERS CHOOSE US
    </span>
    <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-tight">
      EV Charger One in {location.name}
    </h2>
  </div>

  <div class="editorial-consensus-block bg-slate-950/80 border border-emerald-500/40 rounded-2xl p-6 text-slate-200 text-sm sm:text-base font-bold leading-relaxed space-y-3">
    <p>
      {trustParagraph}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-emerald-900 font-mono text-xs text-emerald-400">
      <div>✓ 100% Permitted Work</div>
      <div>✓ Direct Utility Rebates</div>
      <div>✓ Zero Hidden Weekend Fees</div>
    </div>
  </div>
</section>
