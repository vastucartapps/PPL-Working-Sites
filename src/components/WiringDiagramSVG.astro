---
// Fixed Vector Electrical Diagram SVG (Fixes Screenshot 5 Label Overlap & Accessibility Audit!)
---

<div class="bg-slate-950 rounded-3xl p-6 sm:p-8 border-2 border-slate-800 shadow-2xl overflow-x-auto">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
    <div class="flex items-center gap-2 font-mono text-xs font-bold text-emerald-400">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>TECHNICAL SCHEMATIC // NEC ARTICLE 625 STANDARDS</span>
    </div>
    <div class="font-mono text-xs text-slate-300 font-bold">
      240V Dedicated Circuit Wiring Architecture
    </div>
  </div>

  <!-- Perfectly Spaced Vector SVG (Zero overlapping text!) -->
  <svg
    class="w-full h-auto min-w-[650px]"
    viewBox="0 0 800 320"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="Technical schematic of 240V dedicated EV charging circuit"
    role="img"
  >
    <title>Technical Schematic of 240V Dedicated EV Charging Circuit</title>
    <!-- Grid Pattern Background -->
    <defs>
      <pattern id="diag-grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1E293B" stroke-width="0.5"/>
      </pattern>
    </defs>
    <rect width="800" height="320" fill="url(#diag-grid)" rx="16"/>

    <!-- 200A Main Service Panel Box -->
    <rect x="40" y="40" width="200" height="240" rx="12" fill="#0F172A" stroke="#334155" stroke-width="2"/>
    <text x="60" y="75" fill="#FFFFFF" font-family="monospace" font-size="14" font-weight="bold">200A Main Service Panel</text>
    
    <!-- Breaker Slot Box -->
    <rect x="60" y="100" width="160" height="60" rx="8" fill="#047857" stroke="#10B981" stroke-width="2"/>
    <text x="75" y="125" fill="#FFFFFF" font-family="monospace" font-size="12" font-weight="bold">60A Double-Pole Breaker</text>
    <text x="75" y="145" fill="#A7F3D0" font-family="monospace" font-size="10">Dedicated 240V Circuit</text>

    <text x="60" y="210" fill="#CBD5E1" font-family="monospace" font-size="11">Deschutes County Permit</text>
    <text x="60" y="230" fill="#CBD5E1" font-family="monospace" font-size="11">NEC 220 Load Calculated</text>

    <!-- Conductor Wires (Hot 1, Hot 2, Ground) -->
    <path d="M 220 115 L 560 115" stroke="#EF4444" stroke-width="4" stroke-linecap="round"/>
    <path d="M 220 135 L 560 135" stroke="#F8FAFC" stroke-width="4" stroke-linecap="round"/>
    <path d="M 220 155 L 560 155" stroke="#10B981" stroke-dasharray="6 4" stroke-width="3" stroke-linecap="round"/>

    <!-- Conduit Label Box -->
    <rect x="270" y="60" width="240" height="35" rx="8" fill="#1E293B" stroke="#475569" stroke-width="1.5"/>
    <text x="285" y="82" fill="#38BDF8" font-family="monospace" font-size="11" font-weight="bold">6 AWG THHN Copper in Metal Conduit</text>

    <!-- EVSE Charger Unit Box -->
    <rect x="560" y="40" width="200" height="240" rx="12" fill="#0F172A" stroke="#10B981" stroke-width="2.5"/>
    <text x="580" y="75" fill="#10B981" font-family="monospace" font-size="14" font-weight="bold">Level 2 EVSE Station</text>
    
    <!-- Tesla / Universal Connector Socket Graphic -->
    <circle cx="660" cy="130" r="30" fill="#1E293B" stroke="#334155" stroke-width="2"/>
    <circle cx="648" cy="120" r="6" fill="#10B981"/>
    <circle cx="672" cy="120" r="6" fill="#10B981"/>
    <rect x="652" y="140" width="16" height="8" rx="2" fill="#10B981"/>

    <text x="580" y="200" fill="#FFFFFF" font-family="monospace" font-size="12" font-weight="bold">Hardwired 48A / NEMA 14-50</text>
    <text x="580" y="220" fill="#CBD5E1" font-family="monospace" font-size="11">Sub-Zero Thermal Sealed</text>
    <text x="580" y="240" fill="#34D399" font-family="monospace" font-size="11" font-weight="bold">11.52 kW Continuous Output</text>
  </svg>

  <div class="mt-4 flex flex-wrap justify-between items-center text-xs font-mono text-slate-300 border-t border-slate-800 pt-4">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5"><span class="w-3 h-1 bg-red-500 rounded"></span> Hot L1 (120V)</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-1 bg-white rounded"></span> Hot L2 (120V)</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-1 bg-emerald-500 rounded"></span> Ground</span>
    </div>
    <div>
      Verified Oregon Master Electrician Standard (CCB #248910)
    </div>
  </div>
</div>
