---
import { SITE_CONFIG } from '../config/site';
import { LocationData } from '../config/locations';

export interface Props {
  location?: LocationData;
  badge?: string;
  title?: string;
  subtitle?: string;
  bullet1?: string;
  bullet2?: string;
  bullet3?: string;
}

const {
  location,
  badge = "⚡ LICENSED ELECTRICAL NETWORK",
  title = "Direct Master Electrician Desk",
  subtitle = "Connect directly with Oregon CCB #248910 licensed electricians for immediate trade dispatch.",
  bullet1 = "✓ 100% Trade Permitted",
  bullet2 = "✓ 24-Hour Response Guarantee",
  bullet3 = "✓ 99.9% Solid Copper Wire"
} = Astro.props;

const phone = location ? location.phone : SITE_CONFIG.phone;
const phoneClean = location ? location.phoneClean : SITE_CONFIG.phoneClean;
const cityName = location ? location.name : SITE_CONFIG.location.city;
---

<div class="bg-slate-950 text-white border-2 border-emerald-500 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 relative overflow-hidden">
  <div class="space-y-3">
    <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-black uppercase tracking-wider text-emerald-400 bg-emerald-950/90 border border-emerald-500/50 px-3 py-1 rounded-md">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      {badge}
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">
      {title}
    </h3>
    <p class="text-xs sm:text-sm text-slate-300 font-bold leading-relaxed">
      {subtitle}
    </p>
  </div>

  <!-- High-Contrast Direct Call Button -->
  <div class="space-y-3 pt-2">
    <a
      href={`tel:${phoneClean}`}
      aria-label={`Call Master Electrician at ${phone}`}
      style="background-color: #047857; color: #ffffff;"
      class="w-full py-4 px-6 text-center text-xs sm:text-sm font-black rounded-xl shadow-xl transition-all hover:bg-emerald-600 border-2 border-emerald-400 flex items-center justify-center gap-2 min-h-[48px]"
    >
      <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
      <span style="color: #ffffff;" class="font-black">CALL: {phone}</span>
    </a>

    <a
      href="/contact"
      aria-label="Request Free Fixed Price Estimate"
      class="w-full py-3.5 px-6 text-center text-xs font-black text-slate-950 bg-white hover:bg-slate-100 rounded-xl shadow-md transition-all border border-slate-300 flex items-center justify-center gap-1 min-h-[48px]"
    >
      <span class="text-slate-950 font-black">Request {cityName} Estimate →</span>
    </a>
  </div>

  <!-- Ultra-Relevant Trust Badges -->
  <div class="pt-4 border-t border-slate-800 grid grid-cols-1 gap-2 font-mono text-xs text-emerald-300 font-bold">
    <div>{bullet1}</div>
    <div>{bullet2}</div>
    <div>{bullet3}</div>
  </div>
</div>
