---
import { LocationData } from '../config/locations';

export interface Props {
  location?: LocationData;
}

const { location } = Astro.props;
const currentCity = location ? location.name : 'Central Oregon';
---

<div class="bg-white border-2 border-brand-slate-200 rounded-3xl p-6 sm:p-10 shadow-2xl space-y-8">
  <div class="max-w-3xl">
    <span class="mono-tag mb-3">// HARDWARE MATRIX AUDIT</span>
    <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
      Level 2 Charger Comparison Matrix ({currentCity})
    </h2>
    <p class="text-xs sm:text-sm text-slate-900 font-bold mt-2">
      Compare continuous amperage, maximum charging speed (miles added per hour), and weather rating specs.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Card 1: Tesla Wall Connector -->
    <div class="bg-slate-950 text-white border-2 border-emerald-500 rounded-2xl p-6 space-y-4 relative overflow-hidden shadow-xl flex flex-col justify-between">
      <div class="absolute top-0 right-0 bg-emerald-500 text-slate-950 font-mono text-[10px] font-black px-3 py-1 rounded-bl-xl uppercase">
        MOST POPULAR
      </div>
      <div class="space-y-3">
        <div class="font-mono text-xs text-emerald-400 font-black">TESLA GEN 3</div>
        <h3 class="text-xl font-black text-white">Tesla Wall Connector</h3>
        <div class="text-3xl font-black text-emerald-400 font-mono">48A / 11.5 kW</div>
        <p class="text-xs text-slate-300 font-bold leading-relaxed">
          Hardwired 60A circuit breaker. Adds up to 44 miles of range per hour. Built for sub-zero mountain weather.
        </p>
      </div>
      <div class="space-y-2 pt-4 border-t border-slate-800 font-mono text-xs text-emerald-300 font-bold">
        <div>✓ 44 Miles / Hour Speed</div>
        <div>✓ NEMA 3R Outdoor Sealed</div>
        <div>✓ Wi-Fi Power Sharing</div>
      </div>
    </div>

    <!-- Card 2: ChargePoint Home Flex -->
    <div class="bg-brand-slate-50 border-2 border-brand-slate-300 rounded-2xl p-6 space-y-4 shadow-sm flex flex-col justify-between">
      <div class="space-y-3">
        <div class="font-mono text-xs text-slate-950 font-black">UNIVERSAL EVSE</div>
        <h3 class="text-xl font-black text-slate-950">ChargePoint Home Flex</h3>
        <div class="text-3xl font-black text-slate-950 font-mono">50A / 12.0 kW</div>
        <p class="text-xs text-slate-900 font-bold leading-relaxed">
          Universal J1772 or NACS plug. Adjustable amperage settings (16A to 50A) for all EV models.
        </p>
      </div>
      <div class="space-y-2 pt-4 border-t border-brand-slate-200 font-mono text-xs text-slate-950 font-bold">
        <div>✓ 37 Miles / Hour Speed</div>
        <div>✓ Smart App Energy Tracking</div>
        <div>✓ NEMA 4 Indoor/Outdoor</div>
      </div>
    </div>

    <!-- Card 3: Grizzl-E Smart -->
    <div class="bg-brand-slate-50 border-2 border-brand-slate-300 rounded-2xl p-6 space-y-4 shadow-sm flex flex-col justify-between">
      <div class="space-y-3">
        <div class="font-mono text-xs text-slate-950 font-black">COLD WEATHER HEAVY DUTY</div>
        <h3 class="text-xl font-black text-slate-950">Grizzl-E Smart Extreme</h3>
        <div class="text-3xl font-black text-slate-950 font-mono">40A / 9.6 kW</div>
        <p class="text-xs text-slate-900 font-bold leading-relaxed">
          Heavy-duty cast aluminum enclosure rated for -30°F sub-zero Cascade winter freeze cycles.
        </p>
      </div>
      <div class="space-y-2 pt-4 border-t border-brand-slate-200 font-mono text-xs text-slate-950 font-bold">
        <div>✓ 30 Miles / Hour Speed</div>
        <div>✓ Sub-Zero Cast Aluminum</div>
        <div>✓ Heavy 24ft Premium Cable</div>
      </div>
    </div>

    <!-- Card 4: NEMA 14-50 Receptacle -->
    <div class="bg-brand-slate-50 border-2 border-brand-slate-300 rounded-2xl p-6 space-y-4 shadow-sm flex flex-col justify-between">
      <div class="space-y-3">
        <div class="font-mono text-xs text-slate-950 font-black">PLUG-IN RECEPTACLE</div>
        <h3 class="text-xl font-black text-slate-950">240V NEMA 14-50 Outlet</h3>
        <div class="text-3xl font-black text-slate-950 font-mono">40A / 9.6 kW</div>
        <p class="text-xs text-slate-900 font-bold leading-relaxed">
          Industrial Hubbell 240V receptacle on a dedicated 50A breaker. Ideal for mobile charging cables.
        </p>
      </div>
      <div class="space-y-2 pt-4 border-t border-brand-slate-200 font-mono text-xs text-slate-950 font-bold">
        <div>✓ 28 Miles / Hour Speed</div>
        <div>✓ Hubbell Industrial Rated</div>
        <div>✓ Versatile Plug-In Design</div>
      </div>
    </div>
  </div>
</div>
