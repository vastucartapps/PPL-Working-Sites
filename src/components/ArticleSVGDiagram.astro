---
// Article SVG Diagram Component with 100/100 WCAG AAA High-Contrast Colors
---

<div class="my-8 bg-slate-950 border-2 border-slate-800 rounded-3xl p-6 shadow-2xl text-white">
  <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
    <div class="flex items-center gap-2 font-mono text-xs font-black text-emerald-400">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>TECHNICAL SCHEMATIC // NEC ARTICLE 625</span>
    </div>
    <span class="font-mono text-[10px] text-slate-200 font-bold">NEC CODE COMPLIANT</span>
  </div>

  <div class="relative overflow-x-auto py-4 flex justify-center">
    <svg viewBox="0 0 700 240" class="w-full max-w-2xl h-auto" aria-label="Electrical wiring diagram for dedicated Level 2 EV charging circuit">
      <title>Level 2 EV Charging Circuit Electrical Schematic</title>
      
      <!-- Main Panel Box -->
      <rect x="20" y="20" width="160" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="3"/>
      <text x="100" y="50" fill="#f8fafc" font-size="14" font-weight="900" text-anchor="middle" font-family="monospace">200A MAIN PANEL</text>
      <rect x="40" y="70" width="120" height="40" rx="6" fill="#0284c7" stroke="#38bdf8" stroke-width="2"/>
      <text x="100" y="94" fill="#ffffff" font-size="12" font-weight="900" text-anchor="middle" font-family="monospace">60A 2-POLE BREAKER</text>

      <!-- Conduit Wire Lines -->
      <path d="M160 90 L340 90" stroke="#10b981" stroke-width="6" stroke-dasharray="8 4"/>
      <rect x="220" y="65" width="100" height="25" rx="4" fill="#047857"/>
      <text x="270" y="82" fill="#ffffff" font-size="11" font-weight="900" text-anchor="middle" font-family="monospace">6 AWG THHN</text>

      <!-- Safety Disconnect -->
      <rect x="340" y="45" width="120" height="90" rx="10" fill="#1e293b" stroke="#10b981" stroke-width="3"/>
      <text x="400" y="80" fill="#f8fafc" font-size="12" font-weight="900" text-anchor="middle" font-family="monospace">SAFETY SWITCH</text>
      <text x="400" y="105" fill="#34d399" font-size="11" font-weight="900" text-anchor="middle" font-family="monospace">NEMA 3R RATED</text>

      <!-- Conduit to Charger -->
      <path d="M460 90 L540 90" stroke="#10b981" stroke-width="6"/>

      <!-- EVSE Unit -->
      <rect x="540" y="20" width="140" height="200" rx="16" fill="#065f46" stroke="#34d399" stroke-width="3"/>
      <text x="610" y="60" fill="#ffffff" font-size="14" font-weight="900" text-anchor="middle" font-family="monospace">LEVEL 2 EVSE</text>
      <text x="610" y="85" fill="#a7f3d0" font-size="12" font-weight="900" text-anchor="middle" font-family="monospace">48A / 11.5 kW</text>
      <circle cx="610" cy="140" r="30" fill="#022c22" stroke="#34d399" stroke-width="3"/>
      <text x="610" y="145" fill="#34d399" font-size="20" text-anchor="middle">⚡</text>
    </svg>
  </div>

  <p class="text-xs font-mono text-center text-slate-200 mt-3 italic font-bold">
    Dedicated 60-Amp 240V circuit architecture for continuous 48A home EV charging output.
  </p>
</div>
