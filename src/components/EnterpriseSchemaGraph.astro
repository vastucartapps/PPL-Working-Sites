---
import { SITE_CONFIG } from '../config/site';

export interface Props {
  title: string;
  description: string;
  path: string;
  cityName?: string;
  pageType?: string;
  images: Array<{
    src: string;
    alt: string;
    caption: string;
  }>;
  faqs?: Array<{ question: string; answer: string }>;
  articleAuthor?: string;
  publishDate?: string;
}

const {
  title,
  description,
  path = '',
  cityName = 'Bend & Central Oregon',
  images = [],
  faqs = [],
  articleAuthor = "Oregon Master Electrician Desk (CCB #248910)",
  publishDate = "2026-01-15"
} = Astro.props;

const currentUrl = `${SITE_CONFIG.baseUrl}${path}`;

// Authoritative Wiki Entities
const wikiEntities = [
  "https://en.wikipedia.org/wiki/Electrician",
  "https://en.wikipedia.org/wiki/Charging_station",
  "https://en.wikipedia.org/wiki/Tesla_Wall_Connector",
  "https://en.wikipedia.org/wiki/National_Electrical_Code",
  "https://en.wikipedia.org/wiki/Bend,_Oregon",
  "https://en.wikipedia.org/wiki/Deschutes_County,_Oregon"
];

// Complete 22+ Standalone Top-Level Schema Array as Specified in AGENTS.md & SCHEMA_TEMPLATE.md
const schemas = [
  // 1. Organization
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_CONFIG.baseUrl}/#organization`,
    "name": SITE_CONFIG.brandName,
    "legalName": "EV Charger One Oregon Electrical Partner Network",
    "url": SITE_CONFIG.baseUrl,
    "logo": `${SITE_CONFIG.baseUrl}/images/brand-logo.webp`,
    "telephone": SITE_CONFIG.phone,
    "sameAs": wikiEntities
  },
  // 2. WebSite
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_CONFIG.baseUrl}/#website`,
    "name": SITE_CONFIG.brandName,
    "url": SITE_CONFIG.baseUrl,
    "publisher": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
  },
  // 3. WebPage
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${currentUrl}#webpage`,
    "url": currentUrl,
    "name": title,
    "description": description
  },
  // 4. ProfilePage
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${SITE_CONFIG.baseUrl}/authors/master-electrician/#profile`,
    "name": articleAuthor,
    "description": "Oregon CCB #248910 Licensed Master Electrician Editorial Desk"
  },
  // 5. TechArticle / Article
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${currentUrl}#article`,
    "headline": title,
    "description": description,
    "mainEntityOfPage": currentUrl,
    "image": images.map(img => `${SITE_CONFIG.baseUrl}${img.src}`),
    "author": { "@id": `${SITE_CONFIG.baseUrl}/#author` },
    "publisher": { "@id": `${SITE_CONFIG.baseUrl}/#organization` },
    "datePublished": publishDate,
    "dateModified": publishDate,
    "proficientLevel": "Expert"
  },
  // 6. Person (Author)
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${SITE_CONFIG.baseUrl}/#author`,
    "name": articleAuthor,
    "jobTitle": "Master Electrician & Electrical Safety Auditor",
    "worksFor": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
  },
  // 7. BreadcrumbList
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${currentUrl}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_CONFIG.baseUrl },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE_CONFIG.baseUrl}/blog` },
      { "@type": "ListItem", "position": 3, "name": title, "item": currentUrl }
    ]
  },
  // 8. HowTo
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "@id": `${currentUrl}#howto`,
    "name": `How to Calculate & Install a 60A EV Charger Circuit in ${cityName}`,
    "description": "Engineering protocol for installing a 60A breaker and 6 AWG THHN copper wire for 48A Level 2 EV charging.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Calculate Continuous Load", "text": "Apply NEC 625 125% continuous load multiplier (48A x 1.25 = 60A breaker requirement)." },
      { "@type": "HowToStep", "position": 2, "name": "Specify 6 AWG THHN Copper Conductor", "text": "Pull 6 AWG THHN copper wire rated for 65A at 75°C terminals inside EMT conduit." },
      { "@type": "HowToStep", "position": 3, "name": "Verify Panel Capacity (NEC Article 220)", "text": "Perform load calculation on main service panel or install a DCC-9 smart load manager." },
      { "@type": "HowToStep", "position": 4, "name": "Pull City of Bend Electrical Permit", "text": "Submit single-line wiring diagram to City of Bend Building Safety Division." },
      { "@type": "HowToStep", "position": 5, "name": "Execute Installation & Inspection", "text": "Torque breaker lugs to 45-50 in-lbs and receive municipal inspector sign-off." }
    ]
  },
  // 9. FAQPage
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${currentUrl}#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  },
  // 10. DefinedTermSet
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    "@id": `${SITE_CONFIG.baseUrl}/#definedtermset`,
    "name": "NEC 2023 Article 625 EV Charging Terms"
  },
  // 11. DefinedTerm (#1)
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${SITE_CONFIG.baseUrl}/#term-continuous-load`,
    "name": "Continuous Electrical Load",
    "description": "An electrical load expected to continue for 3 hours or more, requiring 125% overcurrent protection under NEC 625.42.",
    "inDefinedTermSet": `${SITE_CONFIG.baseUrl}/#definedtermset`
  },
  // 12. DefinedTerm (#2)
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${SITE_CONFIG.baseUrl}/#term-thhn-copper`,
    "name": "6 AWG THHN Copper Conductor",
    "description": "Thermoplastic High Heat-resistant Nylon-coated copper wire rated for 65A at 75°C terminal rating.",
    "inDefinedTermSet": `${SITE_CONFIG.baseUrl}/#definedtermset`
  },
  // 13. DefinedTerm (#3)
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${SITE_CONFIG.baseUrl}/#term-dcc-9`,
    "name": "DCC-9 EV Energy Management Controller",
    "description": "Smart load shedding device that monitors main service panel current and automatically interrupts EV charging if total load exceeds 80%.",
    "inDefinedTermSet": `${SITE_CONFIG.baseUrl}/#definedtermset`
  },
  // 14. Product (#1)
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${SITE_CONFIG.baseUrl}/#product-tesla-wall-connector`,
    "name": "Tesla Wall Connector Gen 3",
    "brand": { "@type": "Brand", "name": "Tesla" },
    "description": "Hardwired 48A Level 2 EV Charger for Tesla & NACS EV Vehicles"
  },
  // 15. Product (#2)
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${SITE_CONFIG.baseUrl}/#product-emporia-evse`,
    "name": "Emporia Level 2 Smart EV Charger",
    "brand": { "@type": "Brand", "name": "Emporia" },
    "description": "48A Hardwired Level 2 Electric Vehicle Charging Station"
  },
  // 16. Product (#3)
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${SITE_CONFIG.baseUrl}/#product-chargepoint-flex`,
    "name": "ChargePoint Home Flex",
    "brand": { "@type": "Brand", "name": "ChargePoint" },
    "description": "Flexible 16A to 50A Hardwired EV Charger"
  },
  // 17. Service
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${currentUrl}#service`,
    "name": "60A Dedicated Circuit Level 2 EV Charger Installation",
    "serviceType": "Electrical Contractor Service",
    "provider": { "@id": `${SITE_CONFIG.baseUrl}/#organization` },
    "areaServed": cityName
  },
  // 18. SpeakableSpecification
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "@id": `${currentUrl}#speakable`,
    "cssSelector": ["h1", ".tldr", ".geo-answer"]
  },
  // 19. ItemList
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${currentUrl}#itemlist`,
    "name": "60A Breaker Installation Protocol Checklist",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Load Calculation (NEC 220)" },
      { "@type": "ListItem", "position": 2, "name": "Conductor Ampacity Sizing (NEC 310.16)" },
      { "@type": "ListItem", "position": 3, "name": "Municipal Electrical Permit Sign-Off" }
    ]
  },
  // 20. Table
  {
    "@context": "https://schema.org",
    "@type": "Table",
    "@id": `${currentUrl}#table`,
    "name": "Technical Specifications & NEC Engineering Matrix"
  },
  // 21-26. 6 x ImageObject Nodes (Hero + 5 Body Section Images)
  ...images.map((img, idx) => ({
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "@id": `${SITE_CONFIG.baseUrl}${img.src}#image${idx + 1}`,
    "url": `${SITE_CONFIG.baseUrl}${img.src}`,
    "contentUrl": `${SITE_CONFIG.baseUrl}${img.src}`,
    "caption": img.caption,
    "description": img.alt,
    "width": 1280,
    "height": 714
  }))
];
---

<!-- Output All Standalone JSON-LD Script Blocks as Specified in BlogSOP AGENTS.md Role D -->
{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
