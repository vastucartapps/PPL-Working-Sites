---
import { SITE_CONFIG } from '../config/site';

export interface Props {
  title: string;
  description: string;
  path: string;
  cityName?: string;
  pageType?: string;
  images: Array<{
    src: string;
    alt: string;
    caption: string;
  }>;
  faqs?: Array<{ question: string; answer: string }>;
  articleAuthor?: string;
  publishDate?: string;
  howToSteps?: Array<{ name: string; text: string }>;
}

const {
  title,
  description,
  path = '',
  cityName = 'Bend & Central Oregon',
  images = [],
  faqs = [],
  articleAuthor = "Oregon Master Electrician Desk (CCB #248910)",
  publishDate = "2026-01-15",
  howToSteps = [
    { name: "Calculate Circuit Load", text: "Apply the NEC 625 125% continuous load multiplier (48A x 1.25 = 60A breaker requirement)." },
    { name: "Select Conductor Gauge", text: "Specify 6 AWG THHN copper wire with 65A rating at 75°C terminals inside EMT metal conduit." },
    { name: "Verify Panel Capacity", text: "Perform an NEC 220 load calculation on existing panel demand or install a DCC-9 smart load manager." },
    { name: "Pull Municipal Permit", text: "Submit single-line wiring diagrams to the City of Bend Building Safety Division or Deschutes County." },
    { name: "Execute Installation & Sign-Off", text: "Mount 60A breaker, torque lug terminals to 45-50 in-lbs, and obtain official municipal inspector sign-off." }
  ]
} = Astro.props;

const currentUrl = `${SITE_CONFIG.baseUrl}${path}`;
const mainImageUrl = images[0] ? `${SITE_CONFIG.baseUrl}${images[0].src}` : `${SITE_CONFIG.baseUrl}/images/hero-ev-charger.webp`;

// Authoritative Wiki Entities
const wikiEntities = [
  "https://en.wikipedia.org/wiki/Electrician",
  "https://en.wikipedia.org/wiki/Charging_station",
  "https://en.wikipedia.org/wiki/Tesla_Wall_Connector",
  "https://en.wikipedia.org/wiki/National_Electrical_Code",
  "https://en.wikipedia.org/wiki/Bend,_Oregon",
  "https://en.wikipedia.org/wiki/Deschutes_County,_Oregon"
];

// 1. Organization Schema
const orgEntity = {
  "@type": "Organization",
  "@id": `${SITE_CONFIG.baseUrl}/#organization`,
  "name": SITE_CONFIG.brandName,
  "legalName": SITE_CONFIG.legalName || "EV Charger One Oregon Electrical Partner Network",
  "url": SITE_CONFIG.baseUrl,
  "logo": `${SITE_CONFIG.baseUrl}/images/brand-logo.webp`,
  "telephone": SITE_CONFIG.phone,
  "email": SITE_CONFIG.contactEmail || "service@evchargerone.com",
  "sameAs": wikiEntities
};

// 2. WebSite Schema
const webSiteEntity = {
  "@type": "WebSite",
  "@id": `${SITE_CONFIG.baseUrl}/#website`,
  "url": SITE_CONFIG.baseUrl,
  "name": SITE_CONFIG.brandName,
  "publisher": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
};

// 3. Person (Author) Schema
const authorEntity = {
  "@type": "Person",
  "@id": `${SITE_CONFIG.baseUrl}/#author`,
  "name": articleAuthor,
  "jobTitle": "Master Electrician & Electrical Safety Auditor",
  "worksFor": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
};

// 4. ContactPoint Schema
const contactPointEntity = {
  "@type": "ContactPoint",
  "@id": `${SITE_CONFIG.baseUrl}/#contactpoint`,
  "telephone": SITE_CONFIG.phone,
  "contactType": "customer service",
  "areaServed": "US-OR",
  "availableLanguage": "en"
};

// 5. PostalAddress Schema
const postalAddressEntity = {
  "@type": "PostalAddress",
  "@id": `${SITE_CONFIG.baseUrl}/#address`,
  "addressLocality": "Bend",
  "addressRegion": "OR",
  "postalCode": "97701",
  "addressCountry": "US"
};

// 6. WebPage Schema
const webPageEntity = {
  "@type": "WebPage",
  "@id": `${currentUrl}#webpage`,
  "url": currentUrl,
  "name": title,
  "description": description,
  "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
  "speakable": { "@id": `${currentUrl}#speakable` }
};

// 7. BreadcrumbList Schema
const breadcrumbEntity = {
  "@type": "BreadcrumbList",
  "@id": `${currentUrl}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_CONFIG.baseUrl },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE_CONFIG.baseUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": title, "item": currentUrl }
  ]
};

// 8. SpeakableSpecification Schema
const speakableEntity = {
  "@type": "SpeakableSpecification",
  "@id": `${currentUrl}#speakable`,
  "cssSelector": ["h1", ".tldr", ".geo-answer"]
};

// 9. TechArticle Schema
const techArticleEntity = {
  "@type": "TechArticle",
  "@id": `${currentUrl}#article`,
  "headline": title,
  "description": description,
  "mainEntityOfPage": currentUrl,
  "image": mainImageUrl,
  "author": { "@id": `${SITE_CONFIG.baseUrl}/#author` },
  "publisher": { "@id": `${SITE_CONFIG.baseUrl}/#organization` },
  "datePublished": publishDate,
  "dateModified": publishDate,
  "proficientLevel": "Expert",
  "dependencies": "NEC 2023 Article 625, City of Bend Electrical Permit, Oregon CCB #248910"
};

// 10. DefinedTermSet Schema
const definedTermSetEntity = {
  "@type": "DefinedTermSet",
  "@id": `${SITE_CONFIG.baseUrl}/#definedtermset`,
  "name": "NEC 2023 Article 625 EV Charging Standard Terms"
};

// 11 & 12. DefinedTerm Schemas (x2)
const term1Entity = {
  "@type": "DefinedTerm",
  "@id": `${SITE_CONFIG.baseUrl}/#term-continuous-load`,
  "name": "Continuous Electrical Load",
  "description": "An electrical load where maximum current is expected to continue for 3 hours or more, requiring 125% overcurrent protection under NEC 625.42.",
  "inDefinedTermSet": { "@id": `${SITE_CONFIG.baseUrl}/#definedtermset` }
};

const term2Entity = {
  "@type": "DefinedTerm",
  "@id": `${SITE_CONFIG.baseUrl}/#term-thhn-copper`,
  "name": "6 AWG THHN Copper Conductor",
  "description": "Thermoplastic High Heat-resistant Nylon-coated copper wire rated for 65A at 75°C terminal temperature rating.",
  "inDefinedTermSet": { "@id": `${SITE_CONFIG.baseUrl}/#definedtermset` }
};

// 13. Service Schema
const serviceEntity = {
  "@type": "Service",
  "@id": `${currentUrl}#service`,
  "name": "60A Dedicated Circuit Level 2 EV Charger Installation",
  "serviceType": "Electrical Contractor Service",
  "provider": { "@id": `${SITE_CONFIG.baseUrl}/#organization` },
  "areaServed": cityName,
  "hasOfferCatalog": { "@id": `${currentUrl}#offercatalog` }
};

// 14. OfferCatalog Schema
const offerCatalogEntity = {
  "@type": "OfferCatalog",
  "@id": `${currentUrl}#offercatalog`,
  "name": `EV Charger Electrical Services in ${cityName}`,
  "itemListElement": [
    {
      "@type": "Offer",
      "name": "Hardwired 48A EV Charger 60A Circuit Installation",
      "priceCurrency": "USD",
      "price": "850.00",
      "priceValidUntil": "2026-12-31"
    }
  ]
};

// 15. HowTo Schema
const howToEntity = {
  "@type": "HowTo",
  "@id": `${currentUrl}#howto`,
  "name": `How to Calculate & Install a 60A EV Charger Circuit in ${cityName}`,
  "description": "Step-by-step engineering protocol for installing a 60A circuit breaker and 6 AWG THHN copper wire for 48A Level 2 EV charging.",
  "step": howToSteps.map((s, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": s.name,
    "text": s.text
  }))
};

// 16-21. ImageObject Schemas (x6 for Hero + 5 Body Images)
const imageSchemas = images.map((img, idx) => ({
  "@type": "ImageObject",
  "@id": `${SITE_CONFIG.baseUrl}${img.src}#image${idx + 1}`,
  "url": `${SITE_CONFIG.baseUrl}${img.src}`,
  "contentUrl": `${SITE_CONFIG.baseUrl}${img.src}`,
  "caption": img.caption || img.alt,
  "description": img.alt,
  "width": 1280,
  "height": 714,
  "author": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
}));

// 22. FAQPage Schema
const faqEntity = faqs.length > 0 ? {
  "@type": "FAQPage",
  "@id": `${currentUrl}#faq`,
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// Combined Flat @graph payload containing ALL 22 Entities
const fullGraphPayload = {
  "@context": "https://schema.org",
  "@graph": [
    orgEntity,
    webSiteEntity,
    authorEntity,
    contactPointEntity,
    postalAddressEntity,
    webPageEntity,
    breadcrumbEntity,
    speakableEntity,
    techArticleEntity,
    definedTermSetEntity,
    term1Entity,
    term2Entity,
    serviceEntity,
    offerCatalogEntity,
    howToEntity,
    ...imageSchemas,
    ...(faqEntity ? [faqEntity] : [])
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(fullGraphPayload)} />
