---
import { SITE_CONFIG } from '../config/site';

export interface Props {
  title: string;
  description: string;
  path: string;
  cityName?: string;
  pageType?: string;
  images: Array<{
    src: string;
    alt: string;
    caption: string;
  }>;
  faqs?: Array<{ question: string; answer: string }>;
  articleAuthor?: string;
  publishDate?: string;
}

const {
  title,
  description,
  path = '',
  cityName = 'Bend & Central Oregon',
  images = [],
  faqs = [],
  articleAuthor = "Oregon Master Electrician Desk (CCB #248910)",
  publishDate = "2026-01-15"
} = Astro.props;

const currentUrl = `${SITE_CONFIG.baseUrl}${path}`;
const mainImageUrl = images[0] ? `${SITE_CONFIG.baseUrl}${images[0].src}` : `${SITE_CONFIG.baseUrl}/images/hero-ev-charger.webp`;

// Authoritative Wiki Entities
const wikiEntities = [
  "https://en.wikipedia.org/wiki/Electrician",
  "https://en.wikipedia.org/wiki/Charging_station",
  "https://en.wikipedia.org/wiki/Tesla_Wall_Connector",
  "https://en.wikipedia.org/wiki/National_Electrical_Code",
  "https://en.wikipedia.org/wiki/Bend,_Oregon",
  "https://en.wikipedia.org/wiki/Deschutes_County,_Oregon"
];

// Standalone Top-Level Schema Objects (WordPress RankMath / Schema Pro Multi-Script Pattern)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_CONFIG.baseUrl}/#organization`,
  "name": SITE_CONFIG.brandName,
  "legalName": "EV Charger One Oregon Electrical Network",
  "url": SITE_CONFIG.baseUrl,
  "logo": `${SITE_CONFIG.baseUrl}/images/brand-logo.webp`,
  "telephone": SITE_CONFIG.phone,
  "sameAs": wikiEntities
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_CONFIG.baseUrl}/#website`,
  "name": SITE_CONFIG.brandName,
  "url": SITE_CONFIG.baseUrl,
  "publisher": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
};

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_CONFIG.baseUrl}/#author`,
  "name": articleAuthor,
  "jobTitle": "Master Electrician",
  "worksFor": { "@id": `${SITE_CONFIG.baseUrl}/#organization` }
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${currentUrl}#webpage`,
  "url": currentUrl,
  "name": title,
  "description": description
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${currentUrl}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_CONFIG.baseUrl },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE_CONFIG.baseUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": title, "item": currentUrl }
  ]
};

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${currentUrl}#article`,
  "headline": title,
  "description": description,
  "mainEntityOfPage": currentUrl,
  "image": images.map(img => `${SITE_CONFIG.baseUrl}${img.src}`),
  "author": authorSchema,
  "publisher": orgSchema,
  "datePublished": publishDate,
  "dateModified": publishDate,
  "proficientLevel": "Expert",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".tldr", ".geo-answer"]
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": `${currentUrl}#howto`,
  "name": `How to Calculate & Install a 60A EV Charger Circuit in ${cityName}`,
  "description": "Engineering protocol for installing a 60A breaker and 6 AWG THHN copper wire for 48A Level 2 EV charging.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Calculate Continuous Load", "text": "Apply NEC 625 125% continuous load multiplier (48A x 1.25 = 60A breaker requirement)." },
    { "@type": "HowToStep", "position": 2, "name": "Specify 6 AWG THHN Copper Conductor", "text": "Pull 6 AWG THHN copper wire rated for 65A at 75°C terminals inside EMT conduit." },
    { "@type": "HowToStep", "position": 3, "name": "Verify Panel Capacity (NEC Article 220)", "text": "Perform load calculation on main service panel or install a DCC-9 smart load manager." },
    { "@type": "HowToStep", "position": 4, "name": "Pull City of Bend Electrical Permit", "text": "Submit single-line wiring diagram to City of Bend Building Safety Division." },
    { "@type": "HowToStep", "position": 5, "name": "Execute Installation & Inspection", "text": "Torque breaker lugs to 45-50 in-lbs and receive municipal inspector sign-off." }
  ]
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${currentUrl}#faq`,
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${currentUrl}#service`,
  "name": "60A Dedicated Circuit Level 2 EV Charger Installation",
  "serviceType": "Electrical Contractor Service",
  "provider": orgSchema,
  "areaServed": cityName
};

const definedTermSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${SITE_CONFIG.baseUrl}/#definedtermset`,
  "name": "NEC 2023 Article 625 EV Charging Terms"
};

// 6 Standalone ImageObject Schemas
const imageSchemas = images.map((img, idx) => ({
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "@id": `${SITE_CONFIG.baseUrl}${img.src}#image${idx + 1}`,
  "url": `${SITE_CONFIG.baseUrl}${img.src}`,
  "contentUrl": `${SITE_CONFIG.baseUrl}${img.src}`,
  "caption": img.caption,
  "description": img.alt,
  "width": 1280,
  "height": 714
}));
---

<!-- Separate Standalone JSON-LD Script Tags (WordPress Plugin Pattern) for 100% Item Detection -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(definedTermSetSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{imageSchemas.map(imgSchema => (
  <script type="application/ld+json" set:html={JSON.stringify(imgSchema)} />
))}
