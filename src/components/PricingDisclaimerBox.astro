---
import { SITE_CONFIG } from '../config/site';

export interface Props {
  locationName?: string;
  utilityName?: string;
  rebateAmount?: string;
}

const {
  locationName = "Central Oregon",
  utilityName = "Pacific Power",
  rebateAmount = "utility rebate"
} = Astro.props;
---

<div class="my-10 bg-slate-950 text-white rounded-3xl p-8 sm:p-10 shadow-2xl relative overflow-hidden border-2 border-emerald-500">
  <!-- Glowing Ambient Accents -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 space-y-6">
    <!-- Header Badge -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
      <span class="font-mono text-xs font-black text-emerald-400 uppercase tracking-widest bg-emerald-950 border border-emerald-500/50 px-3.5 py-1.5 rounded-xl">
        ⚖️ REGIONAL PRICING & TRADE DISCLOSURE — {locationName.toUpperCase()}
      </span>
      <span class="font-mono text-xs font-bold text-slate-300">
        NEC Article 625 Code Compliant
      </span>
    </div>

    <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-bold">
      Installation estimates provided on {SITE_CONFIG.brandName} reflect standard 240V Level 2 residential garage installations in {locationName}. Final project pricing is fixed upon on-site load calculation and varies based on main breaker panel distance, conduit runs, and service upgrades.
    </p>

    <!-- Key Pricing Factors Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 font-mono text-xs font-bold">
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-emerald-300 space-y-1">
        <div class="text-white font-black">💰 Utility Rebate</div>
        <div>{rebateAmount} {utilityName} Instant Cash-Back Rebate</div>
      </div>
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-emerald-300 space-y-1">
        <div class="text-white font-black">🏛️ Municipal Permit</div>
        <div>100% Trade Permit & Building Sign-Off Included</div>
      </div>
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-emerald-300 space-y-1">
        <div class="text-white font-black">⚡ Contractor Network</div>
        <div>Licensed Oregon Electrical Partners</div>
      </div>
    </div>
  </div>
</div>
