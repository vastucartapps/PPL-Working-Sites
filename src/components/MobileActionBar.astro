---
import { SITE_CONFIG } from '../config/site';

export interface Props {
  phone?: string;
}
const { phone = SITE_CONFIG.phone } = Astro.props;
const phoneClean = (phone || "").replace(/[^0-9]/g, '');
---

<div class="fixed bottom-0 left-0 right-0 z-50 bg-slate-950/95 backdrop-blur-md border-t border-slate-800 p-3 sm:hidden shadow-2xl">
  <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
    <a
      href={`tel:${phoneClean}`}
      aria-label={`Call Electrician Hotline at ${phone}`}
      class="bg-emerald-400 hover:bg-emerald-500 text-slate-950 font-black text-xs min-h-[48px] py-3.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg transition-all"
    >
      <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
      <span class="text-slate-950 font-black">CALL NOW</span>
    </a>
    <a
      href="/contact"
      aria-label="Request Free Fixed Price Estimate"
      class="bg-white hover:bg-slate-100 text-slate-950 font-black text-xs min-h-[48px] py-3.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg transition-all border border-slate-300"
    >
      <span class="text-slate-950 font-black">FREE QUOTE →</span>
    </a>
  </div>
</div>
