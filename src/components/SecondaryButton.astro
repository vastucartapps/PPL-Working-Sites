---
export interface Props {
  href: string;
  text: string;
  ariaLabel?: string;
  class?: string;
  icon?: 'phone' | 'arrow' | 'none';
}

const {
  href,
  text,
  ariaLabel,
  class: className = '',
  icon = 'none'
} = Astro.props;
---

<a
  href={href}
  aria-label={ariaLabel || text}
  class={`btn-secondary py-4 px-6 text-center text-xs sm:text-sm font-black transition-all duration-150 inline-flex items-center justify-center gap-2 cursor-pointer ${className}`}
>
  {icon === 'phone' && (
    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
    </svg>
  )}
  <span>{text}</span>
  {icon === 'arrow' && <span class="font-black">→</span>}
</a>
