---
import { SITE_CONFIG } from '../config/site';
import { LocationData } from '../config/locations';
import { getLocalizedPath } from '../utils/LinkHelper';

import BrandLogo from './BrandLogo.astro';

export interface Props {
  location?: LocationData;
}

const { location } = Astro.props;

const phone = location ? location.phone : SITE_CONFIG.phone;
const phoneClean = location ? location.phoneClean : SITE_CONFIG.phoneClean;
const cityName = location ? location.name : SITE_CONFIG.location.city;
---

<footer class="bg-slate-950 text-white border-t border-slate-800 pt-16 pb-12 font-mono text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand & Credentials -->
      <div class="lg:col-span-2 space-y-4">
        <div>
          <BrandLogo light={true} />
        </div>
        <p class="text-slate-300 font-bold leading-relaxed text-xs">
          Licensed Oregon CCB #248910 electrical contractor partner network specializing in continuous 48A Level 2 EV charging, Tesla Wall Connectors, and 200A main panel capacity upgrades across Bend, Redmond, Sisters, Sunriver, La Pine, and Prineville.
        </p>
        <div class="pt-2">
          <a
            href={`tel:${phoneClean}`}
            aria-label={`Call Electrician Hotline at ${phone}`}
            style="background-color: #047857; color: #ffffff;"
            class="hover:bg-emerald-600 px-4 py-2.5 rounded-lg border border-emerald-400 font-black inline-flex items-center gap-2 text-xs"
          >
            <span>CALL: {phone}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Services Links -->
      <div class="space-y-3">
        <div class="font-black text-emerald-400 uppercase tracking-wider text-xs">// SERVICES</div>
        <ul class="space-y-2 text-slate-300 font-bold">
          <li><a href={getLocalizedPath('/services/tesla-wall-connector', location)} class="hover:text-white transition-colors">Tesla Wall Connector</a></li>
          <li><a href={getLocalizedPath('/services/nema-14-50-upgrade', location)} class="hover:text-white transition-colors">240V NEMA 14-50 Outlet</a></li>
          <li><a href={getLocalizedPath('/services/panel-capacity-upgrade', location)} class="hover:text-white transition-colors">200A Panel Upgrade</a></li>
          <li><a href={getLocalizedPath('/services/commercial-ev-charging', location)} class="hover:text-white transition-colors">Residential Garage Charging</a></li>
        </ul>
      </div>

      <!-- Col 3: Service Cities -->
      <div class="space-y-3">
        <div class="font-black text-emerald-400 uppercase tracking-wider text-xs">// SERVICE CITIES</div>
        <ul class="space-y-2 text-slate-300 font-bold">
          <li><a href="/locations/bend" class="hover:text-white transition-colors">Bend, OR (97701)</a></li>
          <li><a href="/locations/redmond" class="hover:text-white transition-colors">Redmond, OR (97756)</a></li>
          <li><a href="/locations/sisters" class="hover:text-white transition-colors">Sisters, OR (97759)</a></li>
          <li><a href="/locations/sunriver" class="hover:text-white transition-colors">Sunriver, OR (97707)</a></li>
          <li><a href="/locations/la-pine" class="hover:text-white transition-colors">La Pine, OR (97739)</a></li>
          <li><a href="/locations/prineville" class="hover:text-white transition-colors">Prineville, OR (97754)</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Compliance -->
      <div class="space-y-3">
        <div class="font-black text-emerald-400 uppercase tracking-wider text-xs">// COMPLIANCE</div>
        <ul class="space-y-2 text-slate-300 font-bold">
          <li><a href="/contractor-disclosure" class="hover:text-white transition-colors">Contractor Disclosure</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/sitemap.xml" class="hover:text-white transition-colors">XML Sitemap</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-slate-800 pt-8 text-center text-slate-400 text-xs leading-relaxed space-y-3">
      <p>
        EV Charger One is a free service to assist homeowners in connecting with local service providers. All contractors/providers are independent and EV Charger One does not warrant or guarantee any work performed. It is the responsibility of the homeowner to verify that the hired contractor furnishes the necessary license and insurance required for the work being performed. All persons depicted in a photo or video are actors or models and not contractors listed on EV Charger One. Same-day and emergency services are subject to provider participation, location, technician availability, and demand.
      </p>
      <p>© {new Date().getFullYear()} {SITE_CONFIG.brandName}. All rights reserved. Oregon Construction Contractors Board (CCB #248910 Partner Network).</p>
    </div>

  </div>
</footer>
