---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseSchemaGraph from './EnterpriseSchemaGraph.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleHeroCard from './ArticleHeroCard.astro';
import PageHeroTrustCard from './PageHeroTrustCard.astro';
import BLUFBlock from './BLUFBlock.astro';
import FAQAccordion from './FAQAccordion.astro';
import PricingDisclaimerBox from './PricingDisclaimerBox.astro';
import { LocationData } from '../config/locations';
import { SITE_CONFIG } from '../config/site';

export interface Section {
  heading: string;
  content: string;
}

export interface Spec {
  label: string;
  value: string;
}

export interface FAQ {
  question: string;
  answer: string;
}

export interface InternalLink {
  text: string;
  href: string;
}

export interface ImageItem {
  src: string;
  alt: string;
  caption: string;
}

export interface Props {
  title: string;
  category: string;
  readTime: string;
  canonicalPath: string;
  bluf: {
    solution: string;
    priceRange: string;
    rebateInfo: string;
    recommendation: string;
  };
  specs: Spec[];
  sections: Section[];
  images: ImageItem[];
  faqs: FAQ[];
  internalLinks: InternalLink[];
  location?: LocationData;
  cityName?: string;
  state?: string;
}

const {
  title,
  category,
  readTime,
  canonicalPath,
  bluf,
  specs,
  sections,
  images = [],
  faqs,
  internalLinks,
  location,
  cityName = 'Bend & Central Oregon',
  state = 'OR'
} = Astro.props;

const pageTitle = `${title} | EV Charger One`;
const pageDescription = `Technical Level 2 EV charging engineering guide for ${cityName}, ${state}. Pacific Power & Midstate Electric rebate filings, NEC Article 625 code compliance, and 48A hardwired installation standards.`;

// Ensure we have 6 images (1 Hero + 5 Body Section Images)
const heroImage = images[0] || {
  src: '/images/blog/hero-60a-breaker-wiring-bend.webp',
  alt: title,
  caption: `Figure 1: ${title} Hero Installation Setup in ${cityName}`
};

const bodyImages = images.slice(1);
---

<BaseLayout title={pageTitle} description={pageDescription} location={location}>
  <EnterpriseSchemaGraph
    title={pageTitle}
    description={pageDescription}
    path={canonicalPath}
    cityName={cityName}
    pageType="blog"
    images={images}
    faqs={faqs}
  />

  <Breadcrumbs pathName={title} />

  <!-- Hero Section -->
  <section class="relative bg-slate-950 text-white overflow-hidden py-12 sm:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="flex flex-wrap items-center gap-3 font-mono text-xs font-bold uppercase tracking-wider text-cyan-400">
            <span class="px-2.5 py-1 bg-cyan-950/80 border border-cyan-800 rounded-md">{category}</span>
            <span>•</span>
            <span>{readTime}</span>
            <span>•</span>
            <span>{cityName} Hub</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            {title}
          </h1>

          <p class="tldr p-4 bg-slate-900/90 border-l-4 border-cyan-500 rounded-r-lg font-mono text-sm sm:text-base text-slate-200 leading-relaxed">
            <strong>TL;DR / Quick Executive Summary:</strong> Hardwired 48A continuous Level 2 EV charging in {cityName} requires a dedicated 60A 2-pole breaker and 6 AWG THHN copper wire inside EMT conduit under NEC 625.42. Romex 6/3 NM-B is strictly limited to 55A (60°C column) and cannot legally be used. Pacific Power offers an instant $500–$1,000 cash-back rebate for licensed Oregon CCB #248910 installations.
          </p>
        </div>

        <div class="lg:col-span-5">
          <!-- Image 1 of 6: Hero Banner Image -->
          <div class="rounded-2xl overflow-hidden border-2 border-slate-800 shadow-2xl bg-slate-900">
            <img
              src={heroImage.src}
              alt={heroImage.alt}
              width="1280"
              height="714"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto object-cover max-h-[360px]"
            />
            <div class="p-3 bg-slate-950 text-slate-300 font-mono text-xs border-t border-slate-800 flex items-center justify-between">
              <span>⚡ {heroImage.caption}</span>
              <span class="text-cyan-400 font-bold uppercase">Oregon CCB #248910 Verified</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Main Content Body -->
  <article class="py-12 sm:py-16 bg-white grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8 space-y-10">
          
          <!-- BLUF (Bottom Line Up Front) Quick Summary Card -->
          <BLUFBlock
            locationName={cityName}
            solution={bluf.solution}
            priceRange={bluf.priceRange}
            rebateInfo={bluf.rebateInfo}
            recommendation={bluf.recommendation}
          />

          <!-- Technical Specifications & NEC Matrix Table -->
          <div class="p-6 bg-slate-50 border-2 border-slate-300 rounded-2xl space-y-4">
            <h2 class="text-xl font-black text-slate-950">Technical Specifications & NEC 2023 Engineering Matrix</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-left font-mono text-xs text-slate-950 border-collapse">
                <thead>
                  <tr class="border-b-2 border-slate-950 bg-slate-200">
                    <th class="p-2.5 font-black">Technical Specification</th>
                    <th class="p-2.5 font-black">Verified Engineering Standard</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-300 font-bold">
                  {specs.map((spec) => (
                    <tr>
                      <td class="p-2.5">{spec.label}</td>
                      <td class="p-2.5 text-cyan-800 font-black">{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Interactive SVG Electrical Wiring Schematic Diagram -->
          <div class="p-6 bg-slate-950 text-white rounded-2xl border-2 border-slate-800 space-y-4 font-mono text-xs">
            <div class="flex items-center justify-between text-cyan-400 font-bold uppercase tracking-wider">
              <span>⚡ Single-Line Electrical Schematic: 60A Breaker to 48A Hardwired EVSE</span>
              <span>NEC 2023 FIG 625.42</span>
            </div>
            <div class="p-4 bg-slate-900 rounded-xl border border-slate-800 text-center space-y-3">
              <div class="text-slate-300 font-sans text-sm font-semibold">
                [200A Main Service Panel] ──(60A 2-Pole Breaker)──► [3/4" EMT Conduit / 6 AWG THHN Copper] ──► [Hardwired 48A Level 2 EVSE]
              </div>
              <div class="grid grid-cols-3 gap-2 text-slate-400 text-[11px] pt-2 border-t border-slate-800">
                <div>Phase A: 6 AWG Black (120V)</div>
                <div>Phase B: 6 AWG Red (120V)</div>
                <div>Ground: 10 AWG Green EGC</div>
              </div>
            </div>
          </div>

          <!-- Section Prose Body with Inline WebP Images (Images 2 through 6) -->
          <div class="prose prose-slate max-w-none text-slate-800 font-normal space-y-10 text-base sm:text-lg leading-relaxed">
            
            {sections.map((sec, idx) => {
              const currentImg = bodyImages[idx];
              return (
                <div class="space-y-4 pt-4 border-t border-slate-200">
                  <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight leading-snug">
                    {sec.heading}
                  </h2>
                  
                  <div class="geo-answer p-4 bg-cyan-50/80 border-l-4 border-cyan-600 rounded-r-lg font-sans text-slate-900 font-medium text-base">
                    <strong>Direct Answer / Machine Extract:</strong> {sec.content.split('\n\n')[0]}
                  </div>

                  <p class="font-normal text-slate-800 leading-relaxed whitespace-pre-line">
                    {sec.content.split('\n\n').slice(1).join('\n\n') || sec.content}
                  </p>

                  <!-- Contextual Body Image insertion for each section (Images #2 to #6) -->
                  {currentImg && (
                    <div class="my-6 rounded-2xl overflow-hidden border-2 border-slate-900 shadow-xl bg-slate-950">
                      <img
                        src={currentImg.src}
                        alt={currentImg.alt}
                        width="1280"
                        height="714"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-auto object-cover max-h-[420px]"
                      />
                      <div class="p-3 bg-slate-950 text-slate-300 font-mono text-xs border-t border-slate-800 flex items-center justify-between">
                        <span>⚡ {currentImg.caption}</span>
                        <span class="text-cyan-400 font-bold uppercase">NEC 625 Code Compliant</span>
                      </div>
                    </div>
                  )}
                </div>
              );
            })}

            <!-- DIY "Don't Hire Us for X" Honest Threshold Trust Moment -->
            <div class="my-10 p-6 bg-amber-50 border-2 border-amber-400 rounded-2xl space-y-3 font-sans text-slate-900">
              <h3 class="text-lg font-black text-amber-950 flex items-center gap-2">
                <span>🛡️ Honest DIY Threshold: When You Do NOT Need a Paid Electrician</span>
              </h3>
              <p class="text-sm font-normal text-amber-900 leading-relaxed">
                If your garage already has an existing, unshared 240V NEMA 14-50 outlet wired with 6 AWG copper back to a 50A breaker, and your EV charging needs are satisfied at 32A or 40A (charging overnight in 8 hours), <strong>you do NOT need to hire us or pay for a new circuit installation</strong>. Simply purchase a plug-in Level 2 charger and plug it directly into your existing NEMA 14-50 outlet. You only need to call a licensed electrical contractor if: 1) You want continuous 48A fast charging on a 60A breaker, 2) Your panel requires a load calculation or 200A upgrade, or 3) You need a City of Bend municipal permit sign-off for the $500 Pacific Power rebate.
              </p>
            </div>

            <!-- Contextual Internal Cross-Links Box -->
            <div class="p-6 bg-cyan-950 text-white rounded-2xl space-y-3 font-mono text-xs my-8 border border-cyan-800">
              <div class="font-black text-cyan-400 uppercase">🔗 Related Technical Guides & Local Hubs:</div>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-bold underline text-slate-200">
                {internalLinks.map((link) => (
                  <li><a href={link.href} class="hover:text-cyan-300 transition-colors">{link.text}</a></li>
                ))}
              </ul>
            </div>

          </div>
        </div>

        <div class="lg:col-span-4 space-y-6">
          <PageHeroTrustCard
            badge={`⚡ ${cityName.toUpperCase()} DISPATCH`}
            title={`EV Electrician in ${cityName}`}
            subtitle={`Speak directly with Oregon CCB licensed master electricians serving ${cityName} and surrounding corridors.`}
          />
        </div>
      </div>
    </div>
  </article>

  <!-- 10 Topic-Specific Verified Technical FAQs -->
  <FAQAccordion
    title={`${title} FAQs (10 Verified Answers)`}
    faqs={faqs}
  />

  <section class="py-12 bg-slate-100 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <PricingDisclaimerBox />
    </div>
  </section>

  <section class="py-16 bg-slate-900 text-white grid-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ArticleHeroCard
        title={`Ready to Install Your EV Charger in ${cityName}?`}
        subtitle="Lock in your $500–$1,000 Pacific Power cash-back rebate before funds expire."
      />
    </div>
  </section>
</BaseLayout>
